model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 02_Staging

	annotation PBI_QueryGroupOrder = 2

queryGroup '00_Parameters & Functions'

	annotation PBI_QueryGroupOrder = 1

queryGroup 01_Source

	annotation PBI_QueryGroupOrder = 2

queryGroup 03_Transformations

	annotation PBI_QueryGroupOrder = 3

queryGroup 04_DataModel

	annotation PBI_QueryGroupOrder = 4

queryGroup 04_DataModel\Dimensions

	annotation PBI_QueryGroupOrder = 0

queryGroup 04_DataModel\Facts

	annotation PBI_QueryGroupOrder = 1

queryGroup '05_QA & Reconciliation'

	annotation PBI_QueryGroupOrder = 7

queryGroup 99_Archive

	annotation PBI_QueryGroupOrder = 8

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["src_BillionaireIndividual","src_BillionaireCountry","stg_BillionaireIndividual","stg_BillionaireCountry","p_DataFolderPath","p_SnapshotDate","fn_StandardizeCountry","tmp_SourceValidation","tmp_StagingValidation","qa_IndividualByCountry","qa_CountryAggregate","qa_CountryReconciliation"]

annotation PBI_ProTooling = ["DevMode"]

ref cultureInfo en-US

