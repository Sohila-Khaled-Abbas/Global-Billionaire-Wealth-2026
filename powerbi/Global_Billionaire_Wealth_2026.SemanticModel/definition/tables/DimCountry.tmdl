table DimCountry
	lineageTag: 24f7a030-b074-4bc9-b534-2a428f49b5a0

	column iso3
		dataType: string
		lineageTag: b55f8715-d1e7-4dc7-b2f2-feacc1ff5912
		summarizeBy: none
		sourceColumn: iso3

		annotation SummarizationSetBy = Automatic

	column country
		dataType: string
		lineageTag: 2a4d00b0-4221-4d4a-a0fe-893253602c7a
		summarizeBy: none
		sourceColumn: country

		annotation SummarizationSetBy = Automatic

	column wb_country_name
		dataType: string
		lineageTag: 80124e44-e215-4d88-832c-5326d4eaf405
		summarizeBy: none
		sourceColumn: wb_country_name

		annotation SummarizationSetBy = Automatic

	column country_display_label
		dataType: string
		lineageTag: 39570f9d-b5aa-4ecd-bf92-ee2ac159e0b9
		summarizeBy: none
		sourceColumn: country_display_label

		annotation SummarizationSetBy = Automatic

	column country_name_alignment
		dataType: string
		lineageTag: da63de73-5e69-4aee-ab9b-f151772e8ad7
		summarizeBy: none
		sourceColumn: country_name_alignment

		annotation SummarizationSetBy = Automatic

	partition DimCountry = m
		mode: import
		queryGroup: 04_DataModel\Dimensions
		source =
				let
				    // ================================================
				    // 1. REFERENCE STAGING
				    // ================================================
				
				    Source =
				        stg_BillionaireCountry,
				
				    // ================================================
				    // 2. SELECT DIMENSION ATTRIBUTES
				    // ================================================
				
				    SelectedColumns =
				        Table.SelectColumns(
				            Source,
				            {
				                "iso3",
				                "country",
				                "wb_country_name"
				            }
				        ),
				
				    // ================================================
				    // 3. CLEAN DESCRIPTIVE TEXT
				    // ================================================
				
				    CleanedText =
				        Table.TransformColumns(
				            SelectedColumns,
				            {
				                {
				                    "country",
				                    fn_CleanText,
				                    type nullable text
				                },
				                {
				                    "wb_country_name",
				                    fn_CleanText,
				                    type nullable text
				                }
				            }
				        ),
				
				    // ================================================
				    // 4. NORMALIZE NATURAL KEY
				    // ================================================
				
				    NormalizedISO3 =
				        Table.TransformColumns(
				            CleanedText,
				            {
				                {
				                    "iso3",
				                    fn_NormalizeISO3,
				                    type nullable text
				                }
				            }
				        ),
				
				    // ================================================
				    // 5. CREATE DISPLAY LABEL
				    // ================================================
				
				    AddCountryDisplayLabel =
				        Table.AddColumn(
				            NormalizedISO3,
				            "country_display_label",
				            each
				                if [country] = null or [iso3] = null then
				                    null
				                else
				                    [country] & " (" & [iso3] & ")",
				            type nullable text
				        ),
				
				    // ================================================
				    // 6. COMPARE COUNTRY NAMING SYSTEMS
				    // ================================================
				
				    AddNameAlignment =
				        Table.AddColumn(
				            AddCountryDisplayLabel,
				            "country_name_alignment",
				            each
				                if
				                    [country] = null
				                    or [wb_country_name] = null
				                then
				                    "Missing name"
				                else if
				                    Text.Upper([country])
				                    =
				                    Text.Upper([wb_country_name])
				                then
				                    "Same label"
				                else
				                    "Different source label",
				            type text
				        ),
				
				    // ================================================
				    // 7. APPLY FINAL TYPES
				    // ================================================
				
				    ChangedTypes =
				        Table.TransformColumnTypes(
				            AddNameAlignment,
				            {
				                {"iso3", type text},
				                {"country", type text},
				                {"wb_country_name", type text},
				                {"country_display_label", type text},
				                {"country_name_alignment", type text}
				            }
				        ),
				
				    // ================================================
				    // 8. SORT FOR INSPECTION
				    // ================================================
				
				    SortedCountries =
				        Table.Sort(
				            ChangedTypes,
				            {
				                {"country", Order.Ascending}
				            }
				        )
				in
				    SortedCountries

	annotation PBI_ResultType = Table

