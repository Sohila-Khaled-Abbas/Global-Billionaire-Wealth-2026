table DimCountry
	lineageTag: 24f7a030-b074-4bc9-b534-2a428f49b5a0

	column iso3
		dataType: string
		lineageTag: b55f8715-d1e7-4dc7-b2f2-feacc1ff5912
		summarizeBy: none
		sourceColumn: iso3

		annotation SummarizationSetBy = Automatic

	column country
		dataType: string
		lineageTag: 2a4d00b0-4221-4d4a-a0fe-893253602c7a
		summarizeBy: none
		sourceColumn: country

		annotation SummarizationSetBy = Automatic

	column wb_country_name
		dataType: string
		lineageTag: 80124e44-e215-4d88-832c-5326d4eaf405
		summarizeBy: none
		sourceColumn: wb_country_name

		annotation SummarizationSetBy = Automatic

	partition DimCountry = m
		mode: import
		queryGroup: 04_DataModel\Dimensions
		source =
				let
				    Source =
				        stg_BillionaireCountry,
				
				    // Retain descriptive country attributes
				    SelectedColumns =
				        Table.SelectColumns(
				            Source,
				            {
				                "iso3",
				                "country",
				                "wb_country_name"
				            }
				        ),
				
				    // Enforce types
				    ChangedTypes =
				        Table.TransformColumnTypes(
				            SelectedColumns,
				            {
				                {"iso3", type text},
				                {"country", type text},
				                {"wb_country_name", type text}
				            }
				        ),
				
				    // Sort for easier inspection
				    SortedCountries =
				        Table.Sort(
				            ChangedTypes,
				            {{"country", Order.Ascending}}
				        )
				in
				    SortedCountries

	annotation PBI_ResultType = Table

