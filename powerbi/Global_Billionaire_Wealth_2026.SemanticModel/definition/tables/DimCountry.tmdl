	partition DimCountry = m
		mode: import
		queryGroup: 04_DataModel\Dimensions
		source =
				let
				    Source =
				        stg_BillionaireCountry,
				
				    SelectedColumns =
				        Table.SelectColumns(
				            Source,
				            {
				                "iso3",
				                "country",
				                "wb_country_name",
				                "gdp_usd",
				                "population",
				                "gdp_year",
				                "country_wealth_rank",
				                "wealth_concentration_tier",
				                "sector_dominance_score",
				                "dominant_industry_by_wealth"
				            }
				        ),
				
				    RenamedColumns =
				        Table.RenameColumns(
				            SelectedColumns,
				            {
				                {
				                    "country_wealth_rank",
				                    "source_country_wealth_rank"
				                }
				            }
				        ),
				
				    ChangedTypes =
				        Table.TransformColumnTypes(
				            RenamedColumns,
				            {
				                {"iso3", type text},
				                {"country", type text},
				                {"wb_country_name", type text},
				                {"gdp_usd", Currency.Type},
				                {"population", Int64.Type},
				                {"gdp_year", Int64.Type},
				                {"source_country_wealth_rank", Int64.Type},
				                {"wealth_concentration_tier", type text},
				                {"sector_dominance_score", type number},
				                {"dominant_industry_by_wealth", type text}
				            },
				            "en-US"
				        ),
				
				    AddSnapshotDate =
				        Table.AddColumn(
				            ChangedTypes,
				            "snapshot_date",
				            each p_SnapshotDate,
				            type date
				        )
				
				in
				    AddSnapshotDate

	annotation PBI_ResultType = Table

