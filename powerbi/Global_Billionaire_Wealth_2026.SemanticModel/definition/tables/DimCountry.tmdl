		sourceColumn: dominant_industry_by_wealth

		annotation SummarizationSetBy = Automatic

	partition DimCountry = m
		mode: import
		queryGroup: 04_DataModel\Dimensions
		source =
				let
				    // 1. Reference validated country staging
				    Source =
				        stg_BillionaireCountry,
				
				    // 2. Keep country-level descriptive attributes
				    SelectedColumns =
				        Table.SelectColumns(
				            Source,
				            {
				                "iso3",
				                "country",
				                "wb_country_name",
				                "gdp_usd",
				                "population",
				                "gdp_year",
				                "country_wealth_rank",
				                "wealth_concentration_tier",
				                "sector_dominance_score",
				                "dominant_industry_by_wealth"
				            }
				        ),
				
				    // 3. Rename source-specific fields
				    RenamedColumns =
				        Table.RenameColumns(
				            SelectedColumns,
				            {
				                {
				                    "country_wealth_rank",
				                    "source_country_wealth_rank"
				                }
				            }
				        ),
				
				    // 4. Explicitly enforce data types
				    ChangedTypes =
				        Table.TransformColumnTypes(
				            RenamedColumns,
				            {
				                {"iso3", type text},
				                {"country", type text},
				                {"wb_country_name", type text},
				                {"gdp_usd", Currency.Type},
				                {"population", Int64.Type},
				                {"gdp_year", Int64.Type},
				                {"source_country_wealth_rank", Int64.Type},
				                {"wealth_concentration_tier", type text},
				                {"sector_dominance_score", type number},
				                {"dominant_industry_by_wealth", type text}
				            },
				            "en-US"
				        ),
				
				    // 5. Sort country names for easier inspection
				    SortedCountries =
				        Table.Sort(
				            ChangedTypes,
				            {{"country", Order.Ascending}}
				        )
				
				in
				    SortedCountries

	annotation PBI_ResultType = Table

