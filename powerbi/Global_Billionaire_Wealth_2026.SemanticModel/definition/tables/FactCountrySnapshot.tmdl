	partition FactCountrySnapshot = m
		mode: import
		queryGroup: 04_DataModel\Facts
		source =
				let
				    // =========================================
				    // 1. SOURCE
				    // =========================================
				
				    Source =
				        stg_BillionaireCountry,
				
				    // =========================================
				    // 2. SELECT COUNTRY-LEVEL FACT COLUMNS
				    // =========================================
				
				    SelectedColumns =
				        Table.SelectColumns(
				            Source,
				            {
				                "iso3",
				                "country_wealth_rank",
				                "billionaire_count",
				                "total_wealth_usd_m",
				                "total_wealth_usd",
				                "mean_wealth_usd_m",
				                "median_wealth_usd_m",
				                "max_wealth_usd_m",
				                "top_billionaire",
				                "dominant_industry_by_wealth",
				                "self_made_count",
				                "self_made_ratio_pct",
				                "mean_age",
				                "country_wealth_gdp_pct",
				                "billionaires_per_million_pop",
				                "wealth_concentration_tier",
				                "gdp_per_billionaire_bn",
				                "sector_dominance_score",
				                "gdp_usd",
				                "population",
				                "gdp_year"
				            }
				        ),
				
				    // =========================================
				    // 3. STANDARDIZE COUNTRY KEY
				    // =========================================
				
				    StandardizedISO3 =
				        Table.TransformColumns(
				            SelectedColumns,
				            {
				                {
				                    "iso3",
				                    each if _ = null
				                        then null
				                        else Text.Upper(Text.Trim(_)),
				                    type nullable text
				                }
				            }
				        ),
				
				    // =========================================
				    // 4. APPLY DATA TYPES
				    // =========================================
				
				    ChangedTypes =
				        Table.TransformColumnTypes(
				            StandardizedISO3,
				            {
				                {"country_wealth_rank", Int64.Type},
				                {"billionaire_count", Int64.Type},
				                {"total_wealth_usd_m", Currency.Type},
				                {"total_wealth_usd", Currency.Type},
				                {"mean_wealth_usd_m", type number},
				                {"median_wealth_usd_m", type number},
				                {"max_wealth_usd_m", type number},
				                {"top_billionaire", type text},
				                {"dominant_industry_by_wealth", type text},
				                {"self_made_count", Int64.Type},
				                {"self_made_ratio_pct", type number},
				                {"mean_age", type number},
				                {"country_wealth_gdp_pct", type number},
				                {"billionaires_per_million_pop", type number},
				                {"wealth_concentration_tier", type text},
				                {"gdp_per_billionaire_bn", type number},
				                {"sector_dominance_score", type number},
				                {"gdp_usd", Currency.Type},
				                {"population", Int64.Type},
				                {"gdp_year", Int64.Type}
				            },
				            "en-US"
				        ),
				
				    // =========================================
				    // 5. ADD SNAPSHOT DATE
				    // =========================================
				
				    AddSnapshotDate =
				        Table.AddColumn(
				            ChangedTypes,
				            "snapshot_date",
				            each p_SnapshotDate,
				            type date
				        ),
				
				    // =========================================
				    // 6. SORT FOR INSPECTION
				    // =========================================
				
				    SortedCountries =
				        Table.Sort(
				            AddSnapshotDate,
				            {
				                {"country_wealth_rank", Order.Ascending}
				            }
				        ),
				  #"Inserted conditional column" = Table.AddColumn(SortedCountries, "wealth_concentration_sort", each if Text.Contains([wealth_concentration_tier], "Extreme") then 1 else if Text.Contains([wealth_concentration_tier], "Very High") then 2 else if Text.Contains([wealth_concentration_tier], "High") then 3 else if Text.Contains([wealth_concentration_tier], "Moderate") then 4 else if Text.Contains([wealth_concentration_tier], "Low") then 5 else 6, Int64.Type),
				  #"Reordered columns" = Table.ReorderColumns(#"Inserted conditional column", {"iso3", "country_wealth_rank", "billionaire_count", "total_wealth_usd_m", "total_wealth_usd", "mean_wealth_usd_m", "median_wealth_usd_m", "max_wealth_usd_m", "top_billionaire", "dominant_industry_by_wealth", "self_made_count", "self_made_ratio_pct", "mean_age", "country_wealth_gdp_pct", "billionaires_per_million_pop", "wealth_concentration_tier", "wealth_concentration_sort", "gdp_per_billionaire_bn", "sector_dominance_score", "gdp_usd", "population", "gdp_year", "snapshot_date"}),
				  #"Inserted conditional column 1" = Table.AddColumn(#"Reordered columns", "gdp_vintage_status", each if [gdp_year] = 2024 then "2024 reference" else if [gdp_year] = 2023 then "2023 reference" else if [gdp_year] < 2023 then "Earlier vintage – review" else if [gdp_year] > 2024 then "Future vintage – investigate" else "Missing GDP year", type text),
				  #"Reordered columns 1" = Table.ReorderColumns(#"Inserted conditional column 1", {"iso3", "country_wealth_rank", "billionaire_count", "total_wealth_usd_m", "total_wealth_usd", "mean_wealth_usd_m", "median_wealth_usd_m", "max_wealth_usd_m", "top_billionaire", "dominant_industry_by_wealth", "self_made_count", "self_made_ratio_pct", "mean_age", "country_wealth_gdp_pct", "billionaires_per_million_pop", "wealth_concentration_tier", "wealth_concentration_sort", "gdp_per_billionaire_bn", "sector_dominance_score", "gdp_usd", "gdp_vintage_status", "population", "gdp_year", "snapshot_date"})
				
				in
				    #"Reordered columns 1"

