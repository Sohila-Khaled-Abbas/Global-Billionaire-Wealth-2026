	column dominant_industry_by_wealth
		dataType: string
		lineageTag: fbb4a0ba-9fdd-486a-8fbf-ab4ca797a90e
		summarizeBy: none
		sourceColumn: dominant_industry_by_wealth

		annotation SummarizationSetBy = Automatic

	partition FactCountrySnapshot = m
		mode: import
		queryGroup: 04_DataModel\Facts
		source =
				let
				    // =========================================
				    // 1. CONFIGURATION & DYNAMIC METADATA
				    // =========================================
				    Source = stg_BillionaireCountry,
				
				    SnapshotDate = Date.From(p_SnapshotDate),
				    ReferenceYear = Date.Year(SnapshotDate),
				
				    // Single source of truth for column selection and data types
				    ColumnSchema = {
				        {"iso3", type text},
				        {"country_wealth_rank", Int64.Type},
				        {"billionaire_count", Int64.Type},
				        {"top_billionaire", type text},
				        {"dominant_industry_by_wealth", type text},
				        {"total_wealth_usd_m", Currency.Type},
				        {"total_wealth_usd", Currency.Type},
				        {"mean_wealth_usd_m", type number},
				        {"median_wealth_usd_m", type number},
				        {"max_wealth_usd_m", type number},
				        {"self_made_count", Int64.Type},
				        {"self_made_ratio_pct", type number},
				        {"mean_age", type number},
				        {"country_wealth_gdp_pct", type number},
				        {"billionaires_per_million_pop", type number},
				        {"wealth_concentration_tier", type text},
				        {"gdp_per_billionaire_bn", type number},
				        {"sector_dominance_score", type number},
				        {"gdp_usd", Currency.Type},
				        {"population", Int64.Type},
				        {"gdp_year", Int64.Type}
				    },
				
				    // Prefix-to-sort-key mapping (avoids fragile nested if/else chains)
				    TierSortLookup = {
				        {"Extreme", 1},
				        {"Very High", 2},
				        {"High", 3},
				        {"Moderate", 4},
				        {"Low", 5}
				    },
				
				    // =========================================
				    // 2. PROJECT & ENFORCE BASE TYPES
				    // =========================================
				    SelectedColumns = Table.SelectColumns(Source, List.Transform(ColumnSchema, each _{0})),
				    TypedBase = Table.TransformColumnTypes(SelectedColumns, ColumnSchema, "en-US"),
				
				    // =========================================
				    // 3. IN-PLACE TEXT STANDARDIZATION
				    // =========================================
				    CleanedText = Table.TransformColumns(
				        TypedBase,
				        {
				            {"iso3", each if _ = null then null else Text.Upper(Text.Trim(_)), type nullable text},
				            {"top_billionaire", each if _ = null then null else fn_CleanText(_), type nullable text},
				            {"dominant_industry_by_wealth", each if _ = null then null else fn_CleanText(_), type nullable text}
				        }
				    ),
				
				    // =========================================
				    // 4. DERIVED BUSINESS ATTRIBUTES
				    // =========================================
				    AddedSnapshotDate = Table.AddColumn(
				        CleanedText,
				        "snapshot_date",
				        each SnapshotDate,
				        type date
				    ),
				
				    AddedGdpVintage = Table.AddColumn(
				        AddedSnapshotDate,
				        "gdp_vintage_status",
				        each
				            let yr = [gdp_year]
				            in
				                if yr = null then "Missing GDP year"
				                else if yr = ReferenceYear or yr = ReferenceYear - 1 then Number.ToText(yr) & " reference"
				                else if yr < ReferenceYear - 1 then "Earlier vintage – review"
				                else "Future vintage – investigate",
				        type text
				    ),
				
				    AddedWealthGdpComparison = Table.AddColumn(
				        AddedGdpVintage,
				        "wealth_gdp_comparison",
				        each
				            let pct = [country_wealth_gdp_pct]
				            in
				                if pct = null then "Not available"
				                else if pct < 100 then "Below 100%"
				                else "100% or above",
				        type text
				    ),
				
				    AddedConcentrationSort = Table.AddColumn(
				        AddedWealthGdpComparison,
				        "wealth_concentration_sort",
				        each
				            let
				                tier = [wealth_concentration_tier],
				                match = if tier = null then null else List.First(List.Select(TierSortLookup, (item) => Text.StartsWith(tier, item{0})), null)
				            in
				                if match = null then null else match{1},
				        Int64.Type
				    ),
				
				    // =========================================
				    // 5. FINAL COLUMN ORDER (OPTIONAL FOR UI)
				    // =========================================
				    FinalColumnOrder = {
				        "iso3",
				        "country_wealth_rank",
				        "billionaire_count",
				        "top_billionaire",
				        "dominant_industry_by_wealth",
				        "total_wealth_usd_m",
				        "total_wealth_usd",
				        "mean_wealth_usd_m",
				        "median_wealth_usd_m",
				        "max_wealth_usd_m",
				        "self_made_count",
				        "self_made_ratio_pct",
				        "mean_age",
				        "country_wealth_gdp_pct",
				        "wealth_gdp_comparison",
				        "billionaires_per_million_pop",
				        "wealth_concentration_tier",
				        "wealth_concentration_sort",
				        "gdp_per_billionaire_bn",
				        "sector_dominance_score",
				        "gdp_usd",
				        "gdp_vintage_status",
				        "population",
				        "gdp_year",
				        "snapshot_date"
				    },
				
				    ReorderedFinal = Table.ReorderColumns(AddedConcentrationSort, FinalColumnOrder)
				in
				    ReorderedFinal

	annotation PBI_ResultType = Table

