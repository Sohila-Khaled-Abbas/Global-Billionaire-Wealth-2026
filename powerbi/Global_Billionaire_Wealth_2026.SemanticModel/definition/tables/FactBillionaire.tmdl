	partition FactBillionaire = m
		mode: import
		queryGroup: 04_DataModel\Facts
		source =
				let
				    // =========================================
				    // 1. REFERENCE VALIDATED STAGING TABLE
				    // =========================================
				
				    Source =
				        stg_BillionaireIndividual,
				
				    // =========================================
				    // 2. SELECT INDIVIDUAL-LEVEL FIELDS
				    // =========================================
				
				    SelectedColumns =
				        Table.SelectColumns(
				            Source,
				            {
				                "forbes_uri",
				                "rank",
				                "person_name",
				                "iso3",
				                "gender",
				                "age",
				                "birth_year",
				                "state",
				                "city",
				                "net_worth_usd",
				                "source_of_wealth",
				                "primary_industry",
				                "self_made",
				                "scrape_timestamp"
				            }
				        ),
				
				    // =========================================
				    // 3. RENAME INDUSTRY FOREIGN KEY
				    // =========================================
				
				    RenamedColumns =
				        Table.RenameColumns(
				            SelectedColumns,
				            {
				                {"primary_industry", "industry"}
				            }
				        ),
				
				    // =========================================
				    // 4. APPLY SEMANTIC MODEL DATA TYPES
				    // =========================================
				
				    ChangedTypes =
				        Table.TransformColumnTypes(
				            RenamedColumns,
				            {
				                {"forbes_uri", type text},
				                {"rank", Int64.Type},
				                {"person_name", type text},
				                {"iso3", type text},
				                {"gender", type text},
				                {"age", Int64.Type},
				                {"birth_year", Int64.Type},
				                {"state", type text},
				                {"city", type text},
				                {"net_worth_usd", Currency.Type},
				                {"source_of_wealth", type text},
				                {"industry", type text},
				                {"self_made", type logical},
				                {"scrape_timestamp", type datetimezone}
				            },
				            "en-US"
				        ),
				
				    // =========================================
				    // 5. ADD SNAPSHOT DATE
				    // =========================================
				
				    AddSnapshotDate =
				        Table.AddColumn(
				            ChangedTypes,
				            "snapshot_date",
				            each p_SnapshotDate,
				            type date
				        )
				
				in
				    AddSnapshotDate

