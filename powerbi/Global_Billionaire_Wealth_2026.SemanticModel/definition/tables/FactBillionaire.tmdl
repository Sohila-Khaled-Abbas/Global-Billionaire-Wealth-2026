	partition FactBillionaire = m
		mode: import
		queryGroup: 04_DataModel\Facts
		source =
				let
				    // =========================================
				    // 1. CONFIGURATION & METADATA DEFINITIONS
				    // =========================================
				    Source = stg_BillionaireIndividual,
				    SnapshotDate = Date.From(p_SnapshotDate),
				
				    // Single source of truth: {SourceColumn, TargetColumn, DataType}
				    ColumnSchema = {
				        {"rank", "rank", Int64.Type},
				        {"person_name", "person_name", type text},
				        {"gender", "gender", type text},
				        {"age", "age", Int64.Type},
				        {"birth_year", "birth_year", Int64.Type},
				        {"iso3", "iso3", type text},
				        {"state", "state", type text},
				        {"city", "city", type text},
				        {"net_worth_usd", "net_worth_usd", Currency.Type},
				        {"source_of_wealth", "source_of_wealth", type text},
				        {"primary_industry", "industry", type text},
				        {"self_made", "self_made", type logical},
				        {"wealth_gdp_ratio_pct", "wealth_gdp_ratio_pct", type number},
				        {"wealth_per_citizen_usd", "wealth_per_citizen_usd", Currency.Type},
				        {"wealth_country_share_pct", "wealth_country_share_pct", type number},
				        {"forbes_uri", "forbes_uri", type text},
				        {"scrape_timestamp", "scrape_timestamp", type datetimezone}
				    },
				
				    // Columns routed through fn_CleanText in place
				    TextColumnsToClean = {
				        "person_name",
				        "source_of_wealth",
				        "industry",
				        "state",
				        "city"
				    },
				
				    // Descending lower-bound thresholds: {MinNetWorthUSD, TierLabel, SortOrder}
				    WealthTierRules = {
				        {100000000000, "$100B+", 1},
				        {50000000000,  "$50B to under $100B", 2},
				        {10000000000,  "$10B to under $50B", 3},
				        {5000000000,   "$5B to under $10B", 4},
				        {1000000000,   "$1B to under $5B", 5},
				        {-Number.PositiveInfinity, "Below $1B", 6}
				    },
				
				    // Ascending exclusive upper-bound thresholds: {MaxExclusiveAge, BandLabel}
				    AgeBandRules = {
				        {30, "Under 30"},
				        {40, "30–39"},
				        {50, "40–49"},
				        {60, "50–59"},
				        {70, "60–69"},
				        {80, "70–79"}
				    },
				
				    // =========================================
				    // 2. PROJECT, RENAME & ENFORCE DATA TYPES
				    // =========================================
				    SourceCols = List.Transform(ColumnSchema, each _{0}),
				    RenamePairs = List.Transform(
				        List.Select(ColumnSchema, each _{0} <> _{1}),
				        each {_{0}, _{1}}
				    ),
				    TypePairs = List.Transform(ColumnSchema, each {_{1}, _{2}}),
				
				    SelectedColumns = Table.SelectColumns(Source, SourceCols),
				    RenamedColumns = Table.RenameColumns(SelectedColumns, RenamePairs),
				    TypedBase = Table.TransformColumnTypes(RenamedColumns, TypePairs, "en-US"),
				
				    // =========================================
				    // 3. IN-PLACE TEXT STANDARDIZATION
				    // =========================================
				    TextTransformOps =
				        {
				            {"iso3", each if _ = null then null else Text.Upper(Text.Trim(_)), type nullable text}
				        }
				        & List.Transform(
				            TextColumnsToClean,
				            each {_, (val) => if val = null then null else fn_CleanText(val), type nullable text}
				        ),
				
				    CleanedText = Table.TransformColumns(TypedBase, TextTransformOps),
				
				    // =========================================
				    // 4. DERIVED BUSINESS ATTRIBUTES
				    // =========================================
				    AddedSnapshotDate = Table.AddColumn(
				        CleanedText,
				        "snapshot_date",
				        each SnapshotDate,
				        type date
				    ),
				
				    // Evaluate wealth tier label and numeric sort key in a single pass
				    AddedWealthTierRec = Table.AddColumn(
				        AddedSnapshotDate,
				        "_tier_rec",
				        each
				            let
				                nw = [net_worth_usd],
				                matched = if nw = null then null else List.First(List.Select(WealthTierRules, (r) => nw >= r{0}), null)
				            in
				                if matched = null
				                    then [wealth_tier = "Not disclosed", wealth_tier_sort = null]
				                    else [wealth_tier = matched{1}, wealth_tier_sort = matched{2}]
				    ),
				    ExpandedWealthTier = Table.ExpandRecordColumn(
				        AddedWealthTierRec,
				        "_tier_rec",
				        {"wealth_tier", "wealth_tier_sort"}
				    ),
				    TypedWealthTier = Table.TransformColumnTypes(
				        ExpandedWealthTier,
				        {
				            {"wealth_tier", type text},
				            {"wealth_tier_sort", Int64.Type}
				        }
				    ),
				
				    AddedAgeBand = Table.AddColumn(
				        TypedWealthTier,
				        "age_band",
				        each
				            let
				                a = [age],
				                matched = if a = null then null else List.First(List.Select(AgeBandRules, (r) => a < r{0}), null)
				            in
				                if a = null then "Not disclosed"
				                else if matched <> null then matched{1}
				                else "80+",
				        type text
				    ),
				
				    AddedSelfMadeLabel = Table.AddColumn(
				        AddedAgeBand,
				        "self_made_label",
				        each
				            if [self_made] = null then "Not disclosed"
				            else if [self_made] then "Self-made"
				            else "Inherited / family wealth",
				        type text
				    ),
				
				    // =========================================
				    // 5. FINAL COLUMN ORDER (OPTIONAL FOR UI)
				    // =========================================
				    FinalColumnOrder = {
				        "rank",
				        "person_name",
				        "source_of_wealth",
				        "industry",
				        "state",
				        "city",
				        "gender",
				        "age",
				        "age_band",
				        "iso3",
				        "net_worth_usd",
				        "self_made",
				        "self_made_label",
				        "wealth_gdp_ratio_pct",
				        "wealth_per_citizen_usd",
				        "wealth_country_share_pct",
				        "wealth_tier",
				        "wealth_tier_sort",
				        "forbes_uri",
				        "scrape_timestamp",
				        "birth_year",
				        "snapshot_date"
				    },
				
				    ReorderedFinal = Table.ReorderColumns(AddedSelfMadeLabel, FinalColumnOrder)
				in
				    ReorderedFinal

	annotation PBI_ResultType = Table

