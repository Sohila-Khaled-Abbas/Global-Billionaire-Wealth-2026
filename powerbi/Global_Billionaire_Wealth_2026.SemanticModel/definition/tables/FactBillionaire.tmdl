	partition FactBillionaire = m
		mode: import
		queryGroup: 04_DataModel\Facts
		source =
				let
				    // =========================================
				    // 1. REFERENCE VALIDATED STAGING TABLE
				    // =========================================
				
				    Source =
				        stg_BillionaireIndividual,
				
				    // =========================================
				    // 2. SELECT INDIVIDUAL-LEVEL FIELDS
				    // =========================================
				
				    SelectedColumns =
				        Table.SelectColumns(Source, {"rank", "person_name", "gender", "age", "iso3", "state", "city", "net_worth_usd", "source_of_wealth", "primary_industry", "self_made", "wealth_gdp_ratio_pct", "wealth_per_citizen_usd", "wealth_country_share_pct", "forbes_uri", "scrape_timestamp", "birth_year"}),
				
				    // =========================================
				    // 3. RENAME INDUSTRY FOREIGN KEY
				    // =========================================
				
				    RenamedColumns =
				        Table.RenameColumns(
				            SelectedColumns,
				            {
				                {"primary_industry", "industry"}
				            }
				        ),
				
				    // =========================================
				    // 4. APPLY SEMANTIC MODEL DATA TYPES
				    // =========================================
				
				    ChangedTypes =
				        Table.TransformColumnTypes(
				            RenamedColumns,
				            {
				                {"forbes_uri", type text},
				                {"rank", Int64.Type},
				                {"person_name", type text},
				                {"iso3", type text},
				                {"gender", type text},
				                {"age", Int64.Type},
				                {"birth_year", Int64.Type},
				                {"state", type text},
				                {"city", type text},
				                {"net_worth_usd", Currency.Type},
				                {"source_of_wealth", type text},
				                {"industry", type text},
				                {"self_made", type logical},
				                {"scrape_timestamp", type datetimezone}
				            },
				            "en-US"
				        ),
				
				    // =========================================
				    // 5. ADD SNAPSHOT DATE
				    // =========================================
				
				    AddSnapshotDate =
				        Table.AddColumn(
				            ChangedTypes,
				            "snapshot_date",
				            each p_SnapshotDate,
				            type date
				        ),
				  #"Changed column type" = Table.TransformColumnTypes(AddSnapshotDate, {{"wealth_per_citizen_usd", Currency.Type}}),
				  #"Invoked custom function" = Table.TransformColumnTypes(Table.AddColumn(#"Changed column type", "person_name_clean", each fn_CleanText([person_name])), {{"person_name_clean", type text}}),
				  #"Invoked custom function 1" = Table.TransformColumnTypes(Table.AddColumn(#"Invoked custom function", "source_of_wealth_clean", each fn_CleanText([source_of_wealth])), {{"source_of_wealth_clean", type text}}),
				  #"Invoked custom function 2" = Table.TransformColumnTypes(Table.AddColumn(#"Invoked custom function 1", "industry_clean", each fn_CleanText([industry])), {{"industry_clean", type text}}),
				  #"Invoked custom function 3" = Table.TransformColumnTypes(Table.AddColumn(#"Invoked custom function 2", "state_clean", each fn_CleanText([state])), {{"state_clean", type text}}),
				  #"Invoked custom function 4" = Table.TransformColumnTypes(Table.AddColumn(#"Invoked custom function 3", "city_clean", each fn_CleanText([city])), {{"city_clean", type text}}),
				  #"Removed columns" = Table.RemoveColumns(#"Invoked custom function 4", {"person_name", "state", "city", "source_of_wealth", "industry"}),
				  #"Reordered columns" = Table.ReorderColumns(#"Removed columns", {"rank", "person_name_clean", "source_of_wealth_clean", "industry_clean", "state_clean", "city_clean", "gender", "age", "iso3", "net_worth_usd", "self_made", "wealth_gdp_ratio_pct", "wealth_per_citizen_usd", "wealth_country_share_pct", "forbes_uri", "scrape_timestamp", "birth_year", "snapshot_date"}),
				  #"Renamed columns" = Table.RenameColumns(#"Reordered columns", {{"person_name_clean", "person_name"}, {"source_of_wealth_clean", "source_of_wealth"}, {"industry_clean", "industry"}, {"state_clean", "state"}, {"city_clean", "city"}}),
				  #"Inserted conditional column" = Table.AddColumn(#"Renamed columns", "wealth_tier", each if [net_worth_usd] < 1000000000 then "Below $1B" else if [net_worth_usd] < 5000000000 then "$1B to under $5B" else if [net_worth_usd] < 10000000000 then "$5B to under $10B" else if [net_worth_usd] < 50000000000 then "$10B to under $50B" else if [net_worth_usd] < 100000000000 then "$50B to under $100B" else "$100B+", type text),
				  #"Added rank column" = Table.AddRankColumn(#"Inserted conditional column", "wealth_tier_sort", {{"wealth_tier", Order.Descending}}),
				  #"Reordered columns 1" = Table.ReorderColumns(#"Added rank column", {"rank", "person_name", "source_of_wealth", "industry", "state", "city", "gender", "age", "iso3", "net_worth_usd", "self_made", "wealth_gdp_ratio_pct", "wealth_per_citizen_usd", "wealth_country_share_pct", "wealth_tier", "wealth_tier_sort", "forbes_uri", "scrape_timestamp", "birth_year", "snapshot_date"}),
				  #"Inserted conditional column 1" = Table.AddColumn(
				        #"Reordered columns 1",
				        "age_band",
				        each
				            if [age] = null then "Not disclosed"
				            else if [age] < 30 then "Under 30"
				            else if [age] < 40 then "30–39"
				            else if [age] < 50 then "40–49"
				            else if [age] < 60 then "50–59"
				            else if [age] < 70 then "60–69"
				            else if [age] < 80 then "70–79"
				            else "80+",
				        type text
				    ),
				  #"Reordered columns 2" = Table.ReorderColumns(#"Inserted conditional column 1", {"rank", "person_name", "source_of_wealth", "industry", "state", "city", "gender", "age", "age_band", "iso3", "net_worth_usd", "self_made", "wealth_gdp_ratio_pct", "wealth_per_citizen_usd", "wealth_country_share_pct", "wealth_tier", "wealth_tier_sort", "forbes_uri", "scrape_timestamp", "birth_year", "snapshot_date"}),
				  #"Inserted conditional column 2" = Table.AddColumn(#"Reordered columns 2", "self_made_label", each if [self_made] = true then "Self-made" else "Inherited / family wealth", type text),
				  #"Reordered columns 3" = Table.ReorderColumns(#"Inserted conditional column 2", {"rank", "person_name", "source_of_wealth", "industry", "state", "city", "gender", "age", "age_band", "iso3", "net_worth_usd", "self_made", "self_made_label", "wealth_gdp_ratio_pct", "wealth_per_citizen_usd", "wealth_country_share_pct", "wealth_tier", "wealth_tier_sort", "forbes_uri", "scrape_timestamp", "birth_year", "snapshot_date"})
				in
				    #"Reordered columns 3"

	annotation PBI_ResultType = Table

