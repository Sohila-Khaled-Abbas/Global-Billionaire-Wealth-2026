expression tmp_FactCountrySnapshotValidation =
		let
		    Source =
		        FactCountrySnapshot,
		
		    // =========================================
		    // COUNTRY KEY VALIDATION
		    // =========================================
		
		    ISO3Values =
		        List.RemoveNulls(Source[iso3]),
		
		    DistinctISO3 =
		        List.Distinct(ISO3Values),
		
		    ValidISO3 =
		        List.Distinct(DimCountry[iso3]),
		
		    UnknownCountries =
		        List.Difference(
		            DistinctISO3,
		            ValidISO3
		        ),
		
		    // =========================================
		    // BUSINESS METRIC VALIDATION
		    // =========================================
		
		    TotalBillionaires =
		        List.Sum(Source[billionaire_count]),
		
		    InvalidGDP =
		        Table.RowCount(
		            Table.SelectRows(
		                Source,
		                each [gdp_usd] = null
		                    or [gdp_usd] <= 0
		            )
		        ),
		
		    InvalidPopulation =
		        Table.RowCount(
		            Table.SelectRows(
		                Source,
		                each [population] = null
		                    or [population] <= 0
		            )
		        ),
		
		    // =========================================
		    // INDUSTRY CLASSIFICATION VALIDATION
		    // =========================================
		
		    DominantIndustries =
		        List.Distinct(
		            List.RemoveNulls(
		                Source[dominant_industry_by_wealth]
		            )
		        ),
		
		    ValidIndustries =
		        List.Distinct(DimIndustry[industry]),
		
		    UnknownIndustries =
		        List.Difference(
		            DominantIndustries,
		            ValidIndustries
		        ),
		
		    // =========================================
		    // OUTPUT
		    // =========================================
		
		    Result =
		        #table(
		            type table [
		                Check = text,
		                Actual = number,
		                Expected = number,
		                Status = text
		            ],
		            {
		                {
		                    "Snapshot rows",
		                    Table.RowCount(Source),
		                    80,
		                    if Table.RowCount(Source) = 80
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Distinct country keys",
		                    List.Count(DistinctISO3),
		                    80,
		                    if List.Count(DistinctISO3) = 80
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Missing country keys",
		                    Table.RowCount(Source)
		                        - List.Count(ISO3Values),
		                    0,
		                    if Table.RowCount(Source)
		                        = List.Count(ISO3Values)
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Unmatched country keys",
		                    List.Count(UnknownCountries),
		                    0,
		                    if List.IsEmpty(UnknownCountries)
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Total billionaire count",
		                    TotalBillionaires,
		                    3384,
		                    if TotalBillionaires = 3384
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Invalid GDP",
		                    InvalidGDP,
		                    0,
		                    if InvalidGDP = 0
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Invalid population",
		                    InvalidPopulation,
		                    0,
		                    if InvalidPopulation = 0
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Unmatched dominant industries",
		                    List.Count(UnknownIndustries),
		                    0,
		                    if List.IsEmpty(UnknownIndustries)
		                    then "Passed" else "Investigate"
		                }
		            }
		        )
		
		in
		    Result
	lineageTag: 2eaffd0d-2848-4f5a-a6b7-6db54911a890
	queryGroup: 99_Archive

expression tmp_GalaxyFactReconciliation =
		let
		    // Country-level snapshot fact
		    Snapshot =
		        Table.SelectColumns(
		            FactCountrySnapshot,
		            {
		                "iso3",
		                "country_wealth_rank",
		                "billionaire_count",
		                "total_wealth_usd"
		            }
		        ),
		
		    // Recalculate country totals from individual billionaire records
		    IndividualByCountry =
		        Table.Group(
		            FactBillionaire,
		            {"iso3"},
		            {
		                {
		                    "Individual_Billionaire_Count",
		                    each Table.RowCount(_),
		                    Int64.Type
		                },
		                {
		                    "Individual_Total_Wealth_USD",
		                    each List.Sum(List.RemoveNulls([net_worth_usd])),
		                    type number
		                }
		            }
		        ),
		
		    // Full outer join also exposes countries present in only one fact
		    Merged =
		        Table.NestedJoin(
		            Snapshot,
		            {"iso3"},
		            IndividualByCountry,
		            {"iso3"},
		            "IndividualAggregate",
		            JoinKind.FullOuter
		        ),
		
		    Expanded =
		        Table.ExpandTableColumn(
		            Merged,
		            "IndividualAggregate",
		            {
		                "iso3",
		                "Individual_Billionaire_Count",
		                "Individual_Total_Wealth_USD"
		            },
		            {
		                "Individual_ISO3",
		                "Individual_Billionaire_Count",
		                "Individual_Total_Wealth_USD"
		            }
		        ),
		
		    AddReconciliationISO3 =
		        Table.AddColumn(
		            Expanded,
		            "Reconciliation_ISO3",
		            each
		                if [iso3] <> null
		                then [iso3]
		                else [Individual_ISO3],
		            type nullable text
		        ),
		
		    AddCountDifference =
		        Table.AddColumn(
		            AddReconciliationISO3,
		            "Billionaire_Count_Difference",
		            each
		                if [billionaire_count] = null
		                    or [Individual_Billionaire_Count] = null
		                then null
		                else [billionaire_count]
		                    - [Individual_Billionaire_Count],
		            Int64.Type
		        ),
		
		    AddWealthDifference =
		        Table.AddColumn(
		            AddCountDifference,
		            "Wealth_Difference_USD",
		            each
		                if [total_wealth_usd] = null
		                    or [Individual_Total_Wealth_USD] = null
		                then null
		                else Number.Round(
		                    [total_wealth_usd]
		                        - [Individual_Total_Wealth_USD],
		                    2
		                ),
		            type number
		        ),
		
		    AddStatus =
		        Table.AddColumn(
		            AddWealthDifference,
		            "Reconciliation_Status",
		            each
		                if [billionaire_count] = null
		                    or [Individual_Billionaire_Count] = null
		                then "Missing from one fact"
		                else if [Billionaire_Count_Difference] <> 0
		                    or [Wealth_Difference_USD] <> 0
		                then "Investigate"
		                else "Passed",
		            type text
		        ),
		
		    SelectedColumns =
		        Table.SelectColumns(
		            AddStatus,
		            {
		                "Reconciliation_ISO3",
		                "country_wealth_rank",
		                "billionaire_count",
		                "Individual_Billionaire_Count",
		                "Billionaire_Count_Difference",
		                "total_wealth_usd",
		                "Individual_Total_Wealth_USD",
		                "Wealth_Difference_USD",
		                "Reconciliation_Status"
		            }
		        ),
		
		    SortedRows =
		        Table.Sort(
		            SelectedColumns,
		            {{"country_wealth_rank", Order.Ascending}}
		        )
		in
		    SortedRows
	lineageTag: d32c03eb-10b7-439d-afa3-abd1cbffd194
	queryGroup: 99_Archive

expression tmp_GalaxyFactReconciliationSummary =
		let
		    Source = tmp_GalaxyFactReconciliation,
		
		    PassedCountries =
		        Table.RowCount(
		            Table.SelectRows(
		                Source,
		                each [Reconciliation_Status] = "Passed"
		            )
		        ),
		
		    MissingCountries =
		        Table.RowCount(
		            Table.SelectRows(
		                Source,
		                each [Reconciliation_Status] = "Missing from one fact"
		            )
		        ),
		
		    CountMismatches =
		        Table.RowCount(
		            Table.SelectRows(
		                Source,
		                each
		                    [Billionaire_Count_Difference] <> null
		                    and [Billionaire_Count_Difference] <> 0
		            )
		        ),
		
		    WealthMismatches =
		        Table.RowCount(
		            Table.SelectRows(
		                Source,
		                each
		                    [Wealth_Difference_USD] <> null
		                    and [Wealth_Difference_USD] <> 0
		            )
		        ),
		
		    TotalSnapshotBillionaires =
		        List.Sum(FactCountrySnapshot[billionaire_count]),
		
		    TotalIndividualRecords =
		        Table.RowCount(FactBillionaire),
		
		    TotalSnapshotWealth =
		        List.Sum(FactCountrySnapshot[total_wealth_usd]),
		
		    TotalIndividualWealth =
		        List.Sum(FactBillionaire[net_worth_usd]),
		
		    GlobalWealthDifference =
		        Number.Round(
		            TotalSnapshotWealth - TotalIndividualWealth,
		            2
		        ),
		
		    ReconciliationRows =
		        Table.RowCount(Source),
		
		    Result =
		        #table(
		            type table [
		                Check = text,
		                Actual = number,
		                Expected = number,
		                Status = text
		            ],
		            {
		                {
		                    "Reconciliation rows",
		                    ReconciliationRows,
		                    80,
		                    if ReconciliationRows = 80
		                    then "Passed"
		                    else "Investigate"
		                },
		                {
		                    "Countries reconciled",
		                    PassedCountries,
		                    80,
		                    if PassedCountries = 80
		                    then "Passed"
		                    else "Investigate"
		                },
		                {
		                    "Countries missing from either fact",
		                    MissingCountries,
		                    0,
		                    if MissingCountries = 0
		                    then "Passed"
		                    else "Investigate"
		                },
		                {
		                    "Country billionaire-count mismatches",
		                    CountMismatches,
		                    0,
		                    if CountMismatches = 0
		                    then "Passed"
		                    else "Investigate"
		                },
		                {
		                    "Country total-wealth mismatches",
		                    WealthMismatches,
		                    0,
		                    if WealthMismatches = 0
		                    then "Passed"
		                    else "Investigate"
		                },
		                {
		                    "Snapshot billionaire total",
		                    TotalSnapshotBillionaires,
		                    3384,
		                    if TotalSnapshotBillionaires = 3384
		                    then "Passed"
		                    else "Investigate"
		                },
		                {
		                    "Individual fact rows",
		                    TotalIndividualRecords,
		                    3384,
		                    if TotalIndividualRecords = 3384
		                    then "Passed"
		                    else "Investigate"
		                },
		                {
		                    "Global wealth difference (USD)",
		                    GlobalWealthDifference,
		                    0,
		                    if GlobalWealthDifference = 0
		                    then "Passed"
		                    else "Investigate"
		                }
		            }
		        )
		in
		    Result
	lineageTag: 29ce192b-d4bf-44d7-b641-c4f9f17086c9
	queryGroup: 99_Archive

expression tmp_SourceSchemaContract =
		let
		    // ================================================
		    // 1. EXPECTED INDIVIDUAL SOURCE SCHEMA (25 columns)
		    // ================================================
		
		    ExpectedIndividualColumns = {
		        "rank",
		        "person_name",
		        "gender",
		        "age",
		        "birth_year",
		        "country",
		        "iso3",
		        "wb_country_name",
		        "state",
		        "city",
		        "net_worth_usd_m",
		        "net_worth_usd",
		        "source_of_wealth",
		        "industries",
		        "primary_industry",
		        "self_made",
		        "wealth_gdp_ratio_pct",
		        "wealth_per_citizen_usd",
		        "wealth_country_share_pct",
		        "sector_dominance_score",
		        "gdp_usd",
		        "population",
		        "gdp_year",
		        "forbes_uri",
		        "scrape_timestamp"
		    },
		
		    // ================================================
		    // 2. EXPECTED COUNTRY SOURCE SCHEMA (23 columns)
		    // ================================================
		
		    ExpectedCountryColumns = {
		        "country_wealth_rank",
		        "country",
		        "iso3",
		        "wb_country_name",
		        "billionaire_count",
		        "total_wealth_usd_m",
		        "total_wealth_usd",
		        "mean_wealth_usd_m",
		        "median_wealth_usd_m",
		        "max_wealth_usd_m",
		        "top_billionaire",
		        "dominant_industry_by_wealth",
		        "self_made_count",
		        "self_made_ratio_pct",
		        "mean_age",
		        "country_wealth_gdp_pct",
		        "billionaires_per_million_pop",
		        "wealth_concentration_tier",
		        "gdp_per_billionaire_bn",
		        "sector_dominance_score",
		        "gdp_usd",
		        "population",
		        "gdp_year"
		    },
		
		    // ================================================
		    // 3. GET ACTUAL SOURCE COLUMN NAMES
		    // ================================================
		
		    ActualIndividualColumns =
		        Table.ColumnNames(src_BillionaireIndividual),
		
		    ActualCountryColumns =
		        Table.ColumnNames(src_BillionaireCountry),
		
		    // ================================================
		    // 4. COMPARE EXPECTED VS ACTUAL SCHEMA
		    // ================================================
		
		    MissingIndividualColumns =
		        List.Difference(
		            ExpectedIndividualColumns,
		            ActualIndividualColumns
		        ),
		
		    UnexpectedIndividualColumns =
		        List.Difference(
		            ActualIndividualColumns,
		            ExpectedIndividualColumns
		        ),
		
		    MissingCountryColumns =
		        List.Difference(
		            ExpectedCountryColumns,
		            ActualCountryColumns
		        ),
		
		    UnexpectedCountryColumns =
		        List.Difference(
		            ActualCountryColumns,
		            ExpectedCountryColumns
		        ),
		
		    // ================================================
		    // 5. BUILD AUDIT OUTPUT
		    // ================================================
		
		    Result =
		        #table(
		            type table [
		                Source = text,
		                Expected_Columns = Int64.Type,
		                Actual_Columns = Int64.Type,
		                Missing_Columns = text,
		                Unexpected_Columns = text,
		                Status = text
		            ],
		            {
		                {
		                    "src_BillionaireIndividual",
		                    List.Count(ExpectedIndividualColumns),
		                    List.Count(ActualIndividualColumns),
		
		                    if List.IsEmpty(MissingIndividualColumns)
		                    then "None"
		                    else Text.Combine(
		                        MissingIndividualColumns,
		                        ", "
		                    ),
		
		                    if List.IsEmpty(UnexpectedIndividualColumns)
		                    then "None"
		                    else Text.Combine(
		                        UnexpectedIndividualColumns,
		                        ", "
		                    ),
		
		                    if
		                        List.IsEmpty(MissingIndividualColumns)
		                        and List.IsEmpty(UnexpectedIndividualColumns)
		                    then "Passed"
		                    else "Investigate"
		                },
		
		                {
		                    "src_BillionaireCountry",
		                    List.Count(ExpectedCountryColumns),
		                    List.Count(ActualCountryColumns),
		
		                    if List.IsEmpty(MissingCountryColumns)
		                    then "None"
		                    else Text.Combine(
		                        MissingCountryColumns,
		                        ", "
		                    ),
		
		                    if List.IsEmpty(UnexpectedCountryColumns)
		                    then "None"
		                    else Text.Combine(
		                        UnexpectedCountryColumns,
		                        ", "
		                    ),
		
		                    if
		                        List.IsEmpty(MissingCountryColumns)
		                        and List.IsEmpty(UnexpectedCountryColumns)
		                    then "Passed"
		                    else "Investigate"
		                }
		            }
		        )
		in
		    Result
	lineageTag: 43cf9d3e-82df-40d0-809f-cf21dc1136c4
	queryGroup: 99_Archive

expression tmp_SnapshotProvenanceValidation =
		let
		    // ================================================
		    // 1. PRODUCTION FACT TABLES
		    // ================================================
		
		    Individual = FactBillionaire,
		    Country = FactCountrySnapshot,
		
		    ExpectedSnapshotDate = p_SnapshotDate,
		
		    // ================================================
		    // 2. SNAPSHOT DATE VALIDATION
		    // ================================================
		
		    IndividualSnapshotDates =
		        List.Distinct(
		            List.RemoveNulls(Individual[snapshot_date])
		        ),
		
		    CountrySnapshotDates =
		        List.Distinct(
		            List.RemoveNulls(Country[snapshot_date])
		        ),
		
		    IndividualSnapshotDateErrors =
		        Table.RowCount(
		            Table.SelectRows(
		                Individual,
		                each
		                    [snapshot_date] = null
		                    or [snapshot_date] <> ExpectedSnapshotDate
		            )
		        ),
		
		    CountrySnapshotDateErrors =
		        Table.RowCount(
		            Table.SelectRows(
		                Country,
		                each
		                    [snapshot_date] = null
		                    or [snapshot_date] <> ExpectedSnapshotDate
		            )
		        ),
		
		    // ================================================
		    // 3. SCRAPE TIMESTAMP VALIDATION
		    // ================================================
		
		    MissingScrapeTimestamps =
		        Table.RowCount(
		            Table.SelectRows(
		                Individual,
		                each [scrape_timestamp] = null
		            )
		        ),
		
		    NonUTCTimestamps =
		        Table.RowCount(
		            Table.SelectRows(
		                Individual,
		                each
		                    [scrape_timestamp] <> null
		                    and (
		                        DateTimeZone.ZoneHours(
		                            [scrape_timestamp]
		                        ) <> 0
		                        or
		                        DateTimeZone.ZoneMinutes(
		                            [scrape_timestamp]
		                        ) <> 0
		                    )
		            )
		        ),
		
		    ScrapeDateMismatches =
		        Table.RowCount(
		            Table.SelectRows(
		                Individual,
		                each
		                    [scrape_timestamp] = null
		                    or
		                    Date.From(
		                        DateTimeZone.RemoveZone(
		                            [scrape_timestamp]
		                        )
		                    ) <> ExpectedSnapshotDate
		            )
		        ),
		
		    // ================================================
		    // 4. GDP DATA VINTAGE VALIDATION
		    // ================================================
		
		    InvalidGDPYear =
		        Table.RowCount(
		            Table.SelectRows(
		                Country,
		                each
		                    [gdp_year] = null
		                    or [gdp_year] < 2023
		                    or [gdp_year] > 2024
		            )
		        ),
		
		    // ================================================
		    // 5. BUILD VALIDATION RESULT
		    // ================================================
		
		    Result =
		        #table(
		            type table [
		                Check = text,
		                Actual = number,
		                Expected = number,
		                Status = text
		            ],
		            {
		                {
		                    "Individual distinct snapshot dates",
		                    List.Count(IndividualSnapshotDates),
		                    1,
		                    if
		                        List.Count(IndividualSnapshotDates) = 1
		                        and List.First(IndividualSnapshotDates) = ExpectedSnapshotDate
		                    then "Passed"
		                    else "Investigate"
		                },
		
		                {
		                    "Country distinct snapshot dates",
		                    List.Count(CountrySnapshotDates),
		                    1,
		                    if
		                        List.Count(CountrySnapshotDates) = 1
		                        and List.First(CountrySnapshotDates) = ExpectedSnapshotDate
		                    then "Passed"
		                    else "Investigate"
		                },
		
		                {
		                    "Individual snapshot-date mismatches",
		                    IndividualSnapshotDateErrors,
		                    0,
		                    if IndividualSnapshotDateErrors = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "Country snapshot-date mismatches",
		                    CountrySnapshotDateErrors,
		                    0,
		                    if CountrySnapshotDateErrors = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "Missing scrape timestamps",
		                    MissingScrapeTimestamps,
		                    0,
		                    if MissingScrapeTimestamps = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "Non-UTC scrape timestamps",
		                    NonUTCTimestamps,
		                    0,
		                    if NonUTCTimestamps = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "Scrape-date mismatches",
		                    ScrapeDateMismatches,
		                    0,
		                    if ScrapeDateMismatches = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "Invalid GDP year values",
		                    InvalidGDPYear,
		                    0,
		                    if InvalidGDPYear = 0
		                    then "Passed" else "Investigate"
		                }
		            }
		        )
		in
		    Result
	lineageTag: 062486f0-63b5-48e7-a86d-0d3d96b13d39
	queryGroup: 99_Archive

expression tmp_SnapshotProvenanceDetail =
		let
		    Individual = FactBillionaire,
		    Country = FactCountrySnapshot,
		
		    ExpectedSnapshotDate = p_SnapshotDate,
		
		    // ================================================
		    // 1. SNAPSHOT DATE VALIDATION
		    // ================================================
		
		    IndividualSnapshotDates =
		        List.Distinct(
		            List.RemoveNulls(Individual[snapshot_date])
		        ),
		
		    CountrySnapshotDates =
		        List.Distinct(
		            List.RemoveNulls(Country[snapshot_date])
		        ),
		
		    IndividualSnapshotDateErrors =
		        Table.RowCount(
		            Table.SelectRows(
		                Individual,
		                each
		                    [snapshot_date] = null
		                    or [snapshot_date] <> ExpectedSnapshotDate
		            )
		        ),
		
		    CountrySnapshotDateErrors =
		        Table.RowCount(
		            Table.SelectRows(
		                Country,
		                each
		                    [snapshot_date] = null
		                    or [snapshot_date] <> ExpectedSnapshotDate
		            )
