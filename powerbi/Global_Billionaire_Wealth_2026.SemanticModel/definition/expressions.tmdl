		    #"Removed columns" = Table.RemoveColumns(#"Invoked custom function", {"industries"}),
		    #"Expanded industry" = Table.ExpandListColumn(#"Removed columns", "industry"),
		    #"Changed column type" = Table.TransformColumnTypes(#"Expanded industry", {{"industry", type text}}),
		    #"Filtered non-null" = Table.SelectRows(#"Changed column type", each [industry] <> null and [industry] <> ""),
		    #"Removed duplicates" = Table.Distinct(#"Filtered non-null", {"forbes_uri", "industry"})
		in
