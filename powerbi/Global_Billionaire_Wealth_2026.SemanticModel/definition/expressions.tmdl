expression src_BillionaireIndividual =
		let
		    // 1. Read the original CSV file
		    SourceBinary =
		        File.Contents(
		            p_DataFolderPath &
		            "\billionaire_individual_2026.csv"
		        ),
		
		    // 2. Parse CSV structure
		    CsvData =
		        Csv.Document(
		            SourceBinary,
		            [
		                Delimiter = ",",
		                Encoding = 65001,
		                QuoteStyle = QuoteStyle.Csv
		            ]
		        ),
		
		    // 3. Promote the first row to headers
		    PromotedHeaders =
		        Table.PromoteHeaders(
		            CsvData,
		            [PromoteAllScalars = true]
		        )
		
		in
		    PromotedHeaders
	lineageTag: c959f6de-8467-415d-85e3-6e62c997169c
	queryGroup: 01_Source

