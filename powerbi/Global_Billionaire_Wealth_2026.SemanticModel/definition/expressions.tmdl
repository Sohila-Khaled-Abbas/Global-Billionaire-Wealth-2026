		                "max_wealth_usd_m",
		                "self_made_count",
		                "self_made_ratio_pct",
		                "mean_age",
		                "top_billionaire"
		            }
		        ),
		
		    // Prefix aggregate metrics to distinguish their origin
		    RenamedColumns =
		        Table.RenameColumns(
		            SelectedColumns,
		            {
		                {"iso3", "Aggregate_ISO3"},
		                {
		                    "billionaire_count",
		                    "Aggregate_Billionaire_Count"
		                },
		                {
		                    "total_wealth_usd",
		                    "Aggregate_Total_Wealth_USD"
		                },
		                {
		                    "mean_wealth_usd_m",
		                    "Aggregate_Mean_Wealth_USD_M"
		                },
		                {
		                    "median_wealth_usd_m",
		                    "Aggregate_Median_Wealth_USD_M"
		                },
		                {
		                    "max_wealth_usd_m",
		                    "Aggregate_Max_Wealth_USD_M"
		                },
		                {
		                    "self_made_count",
		                    "Aggregate_Self_Made_Count"
		                },
		                {
		                    "self_made_ratio_pct",
		                    "Aggregate_Self_Made_Ratio_Pct"
		                },
		                {
		                    "mean_age",
		                    "Aggregate_Mean_Age"
		                },
		                {
		                    "top_billionaire",
		                    "Aggregate_Top_Billionaire"
		                }
		            }
		        )
		
		in
		    RenamedColumns
