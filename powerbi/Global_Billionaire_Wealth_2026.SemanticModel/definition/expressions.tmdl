expression fn_StandardizeCountry =
		let
		    Source = (CountryName as nullable text) as nullable text =>
		if CountryName = null then
		    null
		else
		    let
		        // Replace non-breaking spaces with regular spaces
		        ReplaceNBSP =
		            Text.Replace(
		                CountryName,
		                Character.FromNumber(160),
		                " "
		            ),
		
		        // Remove non-printable characters
		        CleanText =
		            Text.Clean(ReplaceNBSP),
		
		        // Remove leading and trailing spaces
		        TrimText =
		            Text.Trim(CleanText),
		
		        // Split and remove empty tokens
		        Words =
		            List.Select(
		                Text.Split(TrimText, " "),
		                each _ <> ""
		            ),
		
		        // Reconstruct with single spaces
		        StandardizedCountry =
		            Text.Combine(Words, " ")
		    in
		        StandardizedCountry
		in
		    Source
	lineageTag: 0d60decd-36be-49ec-b81a-963ca6aff604
	queryGroup: '00_Parameters & Functions'

	annotation PBI_ResultType = Function

expression src_BillionaireIndividual =
		let
		    // 1. Read the original CSV file
		    SourceBinary =
		        File.Contents(
		            p_DataFolderPath &
		            "\billionaire_individual_2026.csv"
		        ),
		
		    // 2. Parse CSV structure
		    CsvData =
		        Csv.Document(
		            SourceBinary,
		            [
		                Delimiter = ",",
		                Encoding = 65001,
		                QuoteStyle = QuoteStyle.Csv
		            ]
		        ),
		
		    // 3. Promote the first row to headers
		    PromotedHeaders =
		        Table.PromoteHeaders(
		            CsvData,
		            [PromoteAllScalars = true]
		        )
		
		in
		    PromotedHeaders
	lineageTag: c959f6de-8467-415d-85e3-6e62c997169c
	queryGroup: 01_Source

