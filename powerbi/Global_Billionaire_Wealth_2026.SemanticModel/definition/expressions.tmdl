	annotation PBI_ResultType = Table

expression tmp_AgeBirthYearAudit =
		let
		    Source =
		        stg_BillionaireIndividual,
		
		    SnapshotYear =
		        Date.Year(p_SnapshotDate),
		
		    // Calculate age plausibility using birth year
		    AddAgeStatus =
		        Table.AddColumn(
		            Source,
		            "Age_BirthYear_Status",
		            each
		                let
		                    Age = [age],
		                    BirthYear = [birth_year],
		
		                    MinimumPlausibleAge =
		                        if BirthYear = null then
		                            null
		                        else
		                            SnapshotYear - BirthYear - 1,
		
		                    MaximumPlausibleAge =
		                        if BirthYear = null then
		                            null
		                        else
		                            SnapshotYear - BirthYear
		
		                in
		                    if Age = null and BirthYear = null then
		                        "Both missing"
		
		                    else if Age = null then
		                        "Age missing"
		
		                    else if BirthYear = null then
		                        "Birth year missing"
		
		                    else if BirthYear > SnapshotYear then
		                        "Future birth year"
		
		                    else if Age < MinimumPlausibleAge
		                        or Age > MaximumPlausibleAge then
		                        "Age mismatch"
		
		                    else
		                        "Plausible",
		            type text
		        ),
		
		    // Summarize validation results
		    Summary =
		        Table.Group(
		            AddAgeStatus,
		            {"Age_BirthYear_Status"},
		            {
		                {
		                    "Record_Count",
		                    each Table.RowCount(_),
		                    Int64.Type
		                }
		            }
		        ),
		
		    Sorted =
		        Table.Sort(
		            Summary,
		            {{"Record_Count", Order.Descending}}
		        )
		in
		    Sorted
	lineageTag: 57a96d7d-2cd3-46a6-a4f3-c509dff03164
	queryGroup: 99_Archive

	annotation PBI_ResultType = Table

expression tmp_CountryNullAudit =
		let
		    Source =
		        stg_BillionaireCountry,
		
		    // Count nulls and blank text values
		    CountMissing =
		        (ColumnName as text) as number =>
		            List.Count(
		                List.Select(
		                    Table.Column(Source, ColumnName),
		                    (CurrentValue) =>
		                        if CurrentValue = null then
		                            true
		                        else if Value.Is(CurrentValue, type text) then
		                            Text.Trim(CurrentValue) = ""
		                        else
		                            false
		                )
		            ),
		
		    // Audit every column dynamically
		    AuditRows =
		        List.Transform(
		            Table.ColumnNames(Source),
		            (ColumnName) =>
		                let
		                    MissingCount =
		                        CountMissing(ColumnName)
		                in
		                    [
		                        Column_Name = ColumnName,
		                        Missing_Or_Blank_Count = MissingCount,
		                        Status =
		                            if MissingCount = 0 then
		                                "Passed"
		                            else
		                                "Investigate"
		                    ]
		        ),
		
		    Result =
		        Table.FromRecords(AuditRows)
		in
		    Result
	lineageTag: 5f78a27e-9094-4160-b5b7-d4ac69754390
	queryGroup: 99_Archive

	annotation PBI_ResultType = Table

expression tmp_CountryNumericAudit =
		let
		    Source =
		        stg_BillionaireCountry,
		
		    CountInvalid =
		        (ColumnName as text) as number =>
		            List.Count(
		                List.Select(
		                    List.RemoveNulls(
		                        Table.Column(Source, ColumnName)
		                    ),
		                    each _ <= 0
		                )
		            ),
		
		    InvalidRange =
		        (ColumnName as text, Minimum as number, Maximum as number) as number =>
		            List.Count(
		                List.Select(
		                    List.RemoveNulls(
		                        Table.Column(Source, ColumnName)
		                    ),
		                    each _ < Minimum or _ > Maximum
		                )
		            ),
		
		    Result =
		        #table(
		            type table [
		                Check = text,
		                Invalid_Count = Int64.Type,
		                Rule = text
		            ],
		            {
		                {
		                    "Billionaire count",
		                    CountInvalid("billionaire_count"),
		                    "Must be greater than zero"
		                },
		                {
		                    "Total wealth USD",
		                    CountInvalid("total_wealth_usd"),
		                    "Must be greater than zero"
		                },
		                {
		                    "GDP",
		                    CountInvalid("gdp_usd"),
		                    "Must be greater than zero"
		                },
		                {
		                    "Population",
		                    CountInvalid("population"),
		                    "Must be greater than zero"
		                },
		                {
		                    "Self-made count",
		                    List.Count(
		                        List.Select(
		                            Table.ToRecords(Source),
		                            each
		                                [self_made_count] < 0
		                                or [self_made_count] > [billionaire_count]
		                        )
		                    ),
		                    "Between zero and billionaire count"
		                },
		                {
		                    "Mean wealth",
		                    CountInvalid("mean_wealth_usd_m"),
		                    "Must be greater than zero"
		                },
		                {
		                    "Median wealth",
		                    CountInvalid("median_wealth_usd_m"),
		                    "Must be greater than zero"
		                },
		                {
		                    "Maximum wealth",
		                    CountInvalid("max_wealth_usd_m"),
		                    "Must be greater than zero"
		                },
		                {
		                    "Self-made ratio",
		                    InvalidRange("self_made_ratio_pct", 0, 100),
		                    "Between 0 and 100 percent"
		                },
		                {
		                    "Sector dominance score",
		                    InvalidRange("sector_dominance_score", 0, 100),
		                    "Between 0 and 100"
		                }
		            }
		        )
		in
		    Result
	lineageTag: 892ad27e-93f2-4186-b64f-90bb6526571e
	queryGroup: 99_Archive

	annotation PBI_ResultType = Table

expression tmp_CountryMetricReconciliation =
		let
		    // 1. Source
		    Source =
		        stg_BillionaireCountry,
		
		    // 2. Calculate expected metrics independently
		    AddCalculatedMean =
		        Table.AddColumn(
		            Source,
		            "Calculated_Mean_Wealth_USD_M",
		            each [total_wealth_usd_m]
		                / [billionaire_count],
		            type number
		        ),
		
		    AddCalculatedSelfMade =
		        Table.AddColumn(
		            AddCalculatedMean,
		            "Calculated_SelfMade_Ratio_Pct",
		            each [self_made_count]
		                / [billionaire_count] * 100,
		            type number
		        ),
		
		    AddCalculatedDensity =
		        Table.AddColumn(
		            AddCalculatedSelfMade,
		            "Calculated_Billionaires_Per_Million",
		            each [billionaire_count]
		                / [population] * 1000000,
		            type number
		        ),
		
		    AddCalculatedWealthGDP =
		        Table.AddColumn(
		            AddCalculatedDensity,
		            "Calculated_Wealth_GDP_Pct",
		            each [total_wealth_usd]
		                / [gdp_usd] * 100,
		            type number
		        ),
		
		    AddCalculatedGDPPerBillionaire =
		        Table.AddColumn(
		            AddCalculatedWealthGDP,
		            "Calculated_GDP_Per_Billionaire_Bn",
		            each [gdp_usd]
		                / [billionaire_count]
		                / 1000000000,
		            type number
		        ),
		
		    // 3. Compare actual and calculated metrics
		    AddMeanDifference =
		        Table.AddColumn(
		            AddCalculatedGDPPerBillionaire,
		            "Mean_Wealth_Difference",
		            each Number.Abs(
		                [mean_wealth_usd_m]
		                - [Calculated_Mean_Wealth_USD_M]
		            ),
		            type number
		        ),
		
		    AddSelfMadeDifference =
		        Table.AddColumn(
		            AddMeanDifference,
		            "SelfMade_Ratio_Difference",
		            each Number.Abs(
		                [self_made_ratio_pct]
		                - [Calculated_SelfMade_Ratio_Pct]
		            ),
		            type number
		        ),
		
		    AddDensityDifference =
		        Table.AddColumn(
		            AddSelfMadeDifference,
		            "Density_Difference",
		            each Number.Abs(
		                [billionaires_per_million_pop]
		                - [Calculated_Billionaires_Per_Million]
		            ),
		            type number
		        ),
		
		    AddWealthGDPDifference =
		        Table.AddColumn(
		            AddDensityDifference,
		            "Wealth_GDP_Difference",
		            each Number.Abs(
		                [country_wealth_gdp_pct]
		                - [Calculated_Wealth_GDP_Pct]
		            ),
		            type number
		        ),
		
		    AddGDPDifference =
		        Table.AddColumn(
		            AddWealthGDPDifference,
		            "GDP_Per_Billionaire_Difference",
		            each Number.Abs(
		                [gdp_per_billionaire_bn]
		                - [Calculated_GDP_Per_Billionaire_Bn]
		            ),
		            type number
		        ),
		
		// 4. Select audit fields
		    Output =
		        Table.SelectColumns(
		            AddGDPDifference,
		            {
		                "country",
		                "iso3",
		                "billionaire_count",
		                "total_wealth_usd_m",
		
		                "mean_wealth_usd_m",
		                "Calculated_Mean_Wealth_USD_M",
		                "Mean_Wealth_Difference",
		
		                "self_made_ratio_pct",
		                "Calculated_SelfMade_Ratio_Pct",
		                "SelfMade_Ratio_Difference",
		
		                "billionaires_per_million_pop",
		                "Calculated_Billionaires_Per_Million",
		                "Density_Difference",
		
		                "country_wealth_gdp_pct",
		                "Calculated_Wealth_GDP_Pct",
		                "Wealth_GDP_Difference",
		
		                "gdp_per_billionaire_bn",
		                "Calculated_GDP_Per_Billionaire_Bn",
		                "GDP_Per_Billionaire_Difference"
		            }
		        )
		in
		    Output
	lineageTag: b6d032fe-1070-464c-8c60-3e7846117829
	queryGroup: '05_QA & Reconciliation'

	annotation PBI_ResultType = Table

expression tmp_CountryMetricReconciliationSummary =
		let
		    Source =
		        tmp_CountryMetricReconciliation,
		
		    Metrics = {
		        [
		            Metric = "Mean wealth",
		            DifferenceColumn = "Mean_Wealth_Difference"
		        ],
		        [
		            Metric = "Self-made ratio",
		            DifferenceColumn = "SelfMade_Ratio_Difference"
		        ],
		        [
		            Metric = "Billionaire density",
		            DifferenceColumn = "Density_Difference"
		        ],
		        [
		            Metric = "Wealth-to-GDP",
		            DifferenceColumn = "Wealth_GDP_Difference"
		        ],
		        [
		            Metric = "GDP per billionaire",
		            DifferenceColumn = "GDP_Per_Billionaire_Difference"
		        ]
		    },
		
		    SummaryRecords =
		        List.Transform(
		            Metrics,
		            (MetricRecord) =>
		                let
		                    Values =
		                        List.RemoveNulls(
		                            Table.Column(
		                                Source,
		                                MetricRecord[DifferenceColumn]
		                            )
		                        ),
		
		                    MaximumDifference =
		                        if List.IsEmpty(Values)
		                        then null
		                        else List.Max(Values),
		
		                    CountriesAbove001 =
		                        List.Count(
		                            List.Select(
		                                Values,
		                                each _ > 0.01
		                            )
		                        )
		                in
		                    [
		                        Metric = MetricRecord[Metric],
		                        Maximum_Absolute_Difference =
		                            MaximumDifference,
		                        Countries_Above_001 =
		                            CountriesAbove001
		                    ]
		        ),
		
		    Result =
		        Table.FromRecords(SummaryRecords)
		in
		    Result
	lineageTag: 0a9e9a37-f389-49cc-8e18-6103e9226b20
	queryGroup: '05_QA & Reconciliation'

	annotation PBI_ResultType = Table

expression tmp_CountryPrecisionAudit =
		let
		    Source =
		        tmp_CountryMetricReconciliation,
		
		    // Define the expected display precision
		    Tests =
		        #table(
		            type table [
		                Metric = text,
		                SourceColumn = text,
		                CalculatedColumn = text,
		                DifferenceColumn = text,
		                DecimalPlaces = Int64.Type
		            ],
		            {
		                {
		                    "Mean wealth",
		                    "mean_wealth_usd_m",
		                    "Calculated_Mean_Wealth_USD_M",
		                    "Mean_Wealth_Difference",
		                    2
		                },
		                {
		                    "Self-made ratio",
		                    "self_made_ratio_pct",
		                    "Calculated_SelfMade_Ratio_Pct",
		                    "SelfMade_Ratio_Difference",
		                    1
		                },
		                {
		                    "Billionaire density",
		                    "billionaires_per_million_pop",
		                    "Calculated_Billionaires_Per_Million",
		                    "Density_Difference",
		                    4
		                },
		                {
		                    "Wealth-to-GDP",
		                    "country_wealth_gdp_pct",
		                    "Calculated_Wealth_GDP_Pct",
		                    "Wealth_GDP_Difference",
		                    4
		                },
		                {
		                    "GDP per billionaire",
		                    "gdp_per_billionaire_bn",
		                    "Calculated_GDP_Per_Billionaire_Bn",
		                    "GDP_Per_Billionaire_Difference",
		                    2
		                }
		            }
		        ),
		
		    AddMismatchCount =
		        Table.AddColumn(
		            Tests,
		            "Mismatches_After_Rounding",
		            (Test) =>
		                let
		                    SourceColumn =
		                        Test[SourceColumn],
		
		                    CalculatedColumn =
		                        Test[CalculatedColumn],
		
		                    Digits =
		                        Test[DecimalPlaces],
		
		                    Mismatches =
		                        Table.SelectRows(
		                            Source,
		                            (CurrentRow) =>
		                                Number.Round(
		                                    Record.Field(
		                                        CurrentRow,
		                                        SourceColumn
		                                    ),
		                                    Digits
		                                )
		                                <>
		                                Number.Round(
		                                    Record.Field(
		                                        CurrentRow,
		                                        CalculatedColumn
		                                    ),
		                                    Digits
		                                )
		                        )
		                in
		                    Table.RowCount(Mismatches),
		            Int64.Type
		        ),
		
		    AddMaximumDifference =
		        Table.AddColumn(
		            AddMismatchCount,
		            "Maximum_Absolute_Difference",
		            each
		                List.Max(
		                    Table.Column(
		                        Source,
		                        [DifferenceColumn]
		                    )
		                ),
		            type number
		        ),
		
		    Result =
		        Table.SelectColumns(
		            AddMaximumDifference,
		            {
		                "Metric",
		                "DecimalPlaces",
		                "Mismatches_After_Rounding",
		                "Maximum_Absolute_Difference"
		            }
		        )
		in
		    Result
	lineageTag: 3037deaa-a6e1-4b5c-977c-2a97470ae0e8
	queryGroup: 99_Archive

	annotation PBI_ResultType = Table

expression tmp_MeanWealthRoundingExceptions =
		let
		    Source =
		        tmp_CountryMetricReconciliation,
		
		    // Identify the three mismatched countries
		    Exceptions =
		        Table.SelectRows(
		            Source,
		            each
		                Number.Round(
		                    [mean_wealth_usd_m],
		                    2
		                )
		                <>
		                Number.Round(
		                    [Calculated_Mean_Wealth_USD_M],
		                    2
		                )
		        ),
		
		    // Show precise source and calculated values
		    AddSourcePrecision =
		        Table.AddColumn(
		            Exceptions,
		            "Source_Mean_Precise",
		            each Number.ToText(
		                [mean_wealth_usd_m],
		                "0.000000000000",
		                "en-US"
		            ),
		            type text
		        ),
		
		    AddCalculatedPrecision =
		        Table.AddColumn(
		            AddSourcePrecision,
		            "Calculated_Mean_Precise",
		            each Number.ToText(
		                [Calculated_Mean_Wealth_USD_M],
		                "0.000000000000",
		                "en-US"
		            ),
		            type text
		        ),
		
		    // Compare the rounding methods
		    AddSourceRounded =
		        Table.AddColumn(
		            AddCalculatedPrecision,
		            "Source_Rounded_2",
		            each Number.Round(
		                [mean_wealth_usd_m],
		                2
		            ),
		            type number
		        ),
		
		    AddCalculatedRounded =
		        Table.AddColumn(
		            AddSourceRounded,
		            "Calculated_Rounded_2",
		            each Number.Round(
		                [Calculated_Mean_Wealth_USD_M],
		                2
		            ),
		            type number
		        ),
		
		    // Test midpoint rounding away from zero
		    AddAwayFromZero =
		        Table.AddColumn(
		            AddCalculatedRounded,
		            "Calculated_AwayFromZero",
		            each Number.Round(
		                [Calculated_Mean_Wealth_USD_M],
		                2,
		                RoundingMode.AwayFromZero
		            ),
		            type number
		        ),
		
		    // Actual numerical difference
		    AddExactDifference =
		        Table.AddColumn(
		            AddAwayFromZero,
		            "Exact_Difference",
		            each
		                [mean_wealth_usd_m]
		                - [Calculated_Mean_Wealth_USD_M],
		            type number
		        ),
		
		    Output =
		        Table.SelectColumns(
		            AddExactDifference,
		            {
		                "country",
		                "iso3",
		                "billionaire_count",
		                "total_wealth_usd_m",
		                "Source_Mean_Precise",
		                "Calculated_Mean_Precise",
		                "Source_Rounded_2",
		                "Calculated_Rounded_2",
		                "Calculated_AwayFromZero",
		                "Exact_Difference"
		            }
		        )
		in
		    Output
	lineageTag: 97acf402-d0a4-4ec3-ae12-2fc4c3a14ee3
	queryGroup: 99_Archive

	annotation PBI_ResultType = Exception

expression tmp_MeanWealthPrecisionDiagnostic =
		let
		    Source =
		        tmp_CountryMetricReconciliation,
		
		    // Keep the three affected countries
		    Exceptions =
		        Table.SelectRows(
		            Source,
		            each
		                List.Contains(
		                    {"GEO", "PER", "EST"},
		                    [iso3]
		                )
		        ),
		
		    // Show 17 significant digits
		    SourceRaw =
		        Table.AddColumn(
		            Exceptions,
		            "Source_G17",
		            each Number.ToText(
		                [mean_wealth_usd_m],
		                "G17",
		                "en-US"
		            ),
		            type text
		        ),
		
		    CalculatedRaw =
		        Table.AddColumn(
		            SourceRaw,
		            "Calculated_G17",
		            each Number.ToText(
		                [Calculated_Mean_Wealth_USD_M],
		                "G17",
		                "en-US"
		            ),
		            type text
		        ),
		
		    Difference =
		        Table.AddColumn(
		            CalculatedRaw,
		            "Difference_G17",
		            each Number.ToText(
		                [mean_wealth_usd_m]
		                - [Calculated_Mean_Wealth_USD_M],
		                "G17",
		                "en-US"
		            ),
		            type text
		        ),
		
		    Equality =
		        Table.AddColumn(
		            Difference,
		            "Values_Equal",
		            each
		                [mean_wealth_usd_m]
		                = [Calculated_Mean_Wealth_USD_M],
		            type logical
		        ),
		
		    // Explicit rounding modes
		    SourceToEven =
		        Table.AddColumn(
		            Equality,
		            "Source_ToEven",
		            each Number.Round(
		                [mean_wealth_usd_m],
		                2,
		                RoundingMode.ToEven
		            ),
		            type number
		        ),
		
		    CalculatedToEven =
		        Table.AddColumn(
		            SourceToEven,
		            "Calculated_ToEven",
		            each Number.Round(
		                [Calculated_Mean_Wealth_USD_M],
		                2,
		                RoundingMode.ToEven
		            ),
		            type number
		        ),
		
		    SourceAway =
		        Table.AddColumn(
		            CalculatedToEven,
		            "Source_AwayFromZero",
		            each Number.Round(
		                [mean_wealth_usd_m],
		                2,
		                RoundingMode.AwayFromZero
		            ),
		            type number
		        ),
		
		    CalculatedAway =
		        Table.AddColumn(
		            SourceAway,
		            "Calculated_AwayFromZero",
		            each Number.Round(
		                [Calculated_Mean_Wealth_USD_M],
		                2,
		                RoundingMode.AwayFromZero
		            ),
		            type number
		        ),
		
		    Output =
		        Table.SelectColumns(
		            CalculatedAway,
		            {
		                "country",
		                "iso3",
		                "Source_G17",
		                "Calculated_G17",
		                "Difference_G17",
		                "Values_Equal",
		                "Source_ToEven",
		                "Calculated_ToEven",
		                "Source_AwayFromZero",
		                "Calculated_AwayFromZero"
		            }
		        )
		in
		    Output
	lineageTag: 11fb4528-40cb-4812-96dc-478161addeaa
	queryGroup: 99_Archive

	annotation PBI_ResultType = Table

expression tmp_MeanWealthTypeAudit =
		let
		    Source =
		        tmp_CountryMetricReconciliation,
		
		    DescribeType = (InputValue as any) as text =>
		        if InputValue = null then
		            "null"
		        else
		            let
		                ValueType = Value.Type(InputValue),
		                BaseType =
		                    if Type.Is(ValueType, Currency.Type) then "Currency.Type"
		                    else if Type.Is(ValueType, Decimal.Type) then "Decimal.Type"
		                    else if Type.Is(ValueType, Int64.Type) then "Int64.Type"
		                    else if Type.Is(ValueType, Int32.Type) then "Int32.Type"
		                    else if Type.Is(ValueType, Int16.Type) then "Int16.Type"
		                    else if Type.Is(ValueType, Byte.Type) then "Byte.Type"
		                    else if Type.Is(ValueType, Percentage.Type) then "Percentage.Type"
		                    else if Type.Is(ValueType, Double.Type) then "Double.Type"
		                    else if Type.Is(ValueType, type number) then "number"
		                    else if Type.Is(ValueType, type text) then "text"
		                    else if Type.Is(ValueType, type logical) then "logical"
		                    else if Type.Is(ValueType, type date) then "date"
		                    else if Type.Is(ValueType, type datetime) then "datetime"
		                    else if Type.Is(ValueType, type datetimezone) then "datetimezone"
		                    else if Type.Is(ValueType, type time) then "time"
		                    else if Type.Is(ValueType, type duration) then "duration"
		                    else if Type.Is(ValueType, type binary) then "binary"
		                    else if Type.Is(ValueType, type list) then "list"
		                    else if Type.Is(ValueType, type record) then "record"
		                    else if Type.Is(ValueType, type table) then "table"
		                    else if Type.Is(ValueType, type function) then "function"
		                    else if Type.Is(ValueType, type type) then "type"
		                    else "any",
		                Facets = Type.Facets(ValueType),
		                FacetNames = Record.FieldNames(Facets),
		                FacetSuffix =
		                    if List.IsEmpty(FacetNames) then
		                        ""
		                    else
		                        " ["
		                            & Text.Combine(
		                                List.Transform(
		                                    FacetNames,
		                                    each _ & "=" & (try Text.From(Record.Field(Facets, _)) otherwise "complex")
		                                ),
		                                ", "
		                            )
		                            & "]"
		            in
		                BaseType & FacetSuffix,
		
		    Exceptions =
		        Table.SelectRows(
		            Source,
		            each List.Contains(
		                {"GEO", "PER", "EST"},
		                [iso3]
		            )
		        ),
		
		    AddDiagnostics =
		        Table.AddColumn(
		            Exceptions,
		            "Diagnostics",
		            each
		                let
		                    SourceValue = [mean_wealth_usd_m],
		                    CalculatedValue = [Calculated_Mean_Wealth_USD_M],
		                    SourceNumber = Number.From(SourceValue),
		                    CalculatedNumber = Number.From(CalculatedValue),
		                    SourceCurrency =
		                        Currency.From(
		                            SourceValue,
		                            "en-US",
		                            RoundingMode.ToEven
		                        ),
		                    CalculatedCurrency =
		                        Currency.From(
		                            CalculatedValue,
		                            "en-US",
		                            RoundingMode.ToEven
		                        )
		                in
		                    [
		                        Source_Type = DescribeType(SourceValue),
		                        Calculated_Type = DescribeType(CalculatedValue),
		                        Source_G29 = Number.ToText(SourceNumber, "G29", "en-US"),
		                        Calculated_G29 = Number.ToText(CalculatedNumber, "G29", "en-US"),
		                        Number_Equality = SourceNumber = CalculatedNumber,
		                        Source_Round = Number.Round(SourceNumber, 2, RoundingMode.ToEven),
		                        Calculated_Round = Number.Round(CalculatedNumber, 2, RoundingMode.ToEven),
		                        Source_Currency_Round = Number.Round(SourceCurrency, 2, RoundingMode.ToEven),
		                        Calculated_Currency_Round = Number.Round(CalculatedCurrency, 2, RoundingMode.ToEven)
		                    ],
		            type record
		        ),
		
		    Expanded =
		        Table.ExpandRecordColumn(
		            AddDiagnostics,
		            "Diagnostics",
		            {
		                "Source_Type",
		                "Calculated_Type",
		                "Source_G29",
		                "Calculated_G29",
		                "Number_Equality",
		                "Source_Round",
		                "Calculated_Round",
		                "Source_Currency_Round",
		                "Calculated_Currency_Round"
		            }
		        ),
		
		    Output =
		        Table.SelectColumns(
		            Expanded,
		            {
		                "country",
		                "Source_Type",
		                "Calculated_Type",
		                "Source_G29",
		                "Calculated_G29",
		                "Number_Equality",
		                "Source_Round",
		                "Calculated_Round",
		                "Source_Currency_Round",
		                "Calculated_Currency_Round"
		            }
		        )
		in
		    Output
	lineageTag: 7c573f53-2fc0-4717-b66b-40c53029b349
	queryGroup: 99_Archive

	annotation PBI_ResultType = Table

expression tmp_IndividualAggregationValidation =
		let
		    Source =
		        qa_IndividualByCountry,
		
		    IndividualSource =
		        stg_BillionaireIndividual,
		
		    Result =
		        #table(
		            type table [
		                Check = text,
		                Actual = number,
		                Expected = number,
		                Status = text
		            ],
		            {
		                {
		                    "Distinct country groups",
		                    Table.RowCount(Source),
		                    80,
		                    if Table.RowCount(Source) = 80
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Total billionaire count",
		                    List.Sum(
		                        Source[Individual_Billionaire_Count]
		                    ),
		                    3384,
		                    if List.Sum(
		                        Source[Individual_Billionaire_Count]
		                    ) = 3384
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Individual source records",
		                    Table.RowCount(IndividualSource),
		                    3384,
		                    if Table.RowCount(IndividualSource) = 3384
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Distinct ISO3 keys",
		                    List.Count(
		                        List.Distinct(Source[iso3])
		                    ),
		                    80,
		                    if List.Count(
		                        List.Distinct(Source[iso3])
		                    ) = 80
		                    then "Passed" else "Investigate"
		                }
		            }
		        )
		in
		    Result
