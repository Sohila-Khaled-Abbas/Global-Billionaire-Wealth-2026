expression qa_CountryReconciliation =
		let
		  Source = Table.NestedJoin(qa_IndividualByCountry, {"iso3"}, qa_CountryAggregate, {"iso3"}, "qa_CountryAggregate", JoinKind.FullOuter),
		  #"Expanded qa_CountryAggregate" = Table.ExpandTableColumn(Source, "qa_CountryAggregate", {"country", "iso3", "Aggregate_Billionaire_Count", "Aggregate_Total_Wealth_USD"}, {"country", "Aggregate_ISO3", "Aggregate_Billionaire_Count", "Aggregate_Total_Wealth_USD"}),
		  #"Added custom" = Table.TransformColumnTypes(Table.AddColumn(#"Expanded qa_CountryAggregate", "Count_Difference", each [Individual_Billionaire_Count] - [Aggregate_Billionaire_Count]), {{"Count_Difference", Int64.Type}}),
		  #"Added custom 1" = Table.TransformColumnTypes(Table.AddColumn(#"Added custom", "Wealth_Difference", each [Individual_Total_Wealth_USD] - [Aggregate_Total_Wealth_USD]), {{"Wealth_Difference", Int64.Type}}),
		  #"Added custom 2" = Table.TransformColumnTypes(Table.AddColumn(#"Added custom 1", "Reconciliation_Status", each if [Individual_Billionaire_Count] = null then
		    "Missing from individual data"
		else if [Aggregate_Billionaire_Count] = null then
		    "Missing from country aggregate"
		else if [Count_Difference] <> 0 then
		    "Count mismatch"
		else if Number.Round([Wealth_Difference], 2) <> 0 then
		    "Wealth mismatch"
		else
		    "Matched"), {{"Reconciliation_Status", type text}})
		in
		  #"Added custom 2"
	lineageTag: d32e7f72-5fed-4135-aead-000444168561
	queryGroup: '05_QA & Reconciliation'

