expression qa_IndividualByCountry =
		let
		    // =========================================
		    // 1. SOURCE
		    // =========================================
		
		    Source =
		        stg_BillionaireIndividual,
		
		    // =========================================
		    // 2. GROUP BY COUNTRY
		    // Each row represents one country
		    // =========================================
		
		    GroupedByCountry =
		        Table.Group(
		            Source,
		            {"iso3"},
		            {
		                // Billionaire count
		                {
		                    "Individual_Billionaire_Count",
		                    each Table.RowCount(_),
		                    Int64.Type
		                },
		
		                // Total individual wealth in USD
		                {
		                    "Individual_Total_Wealth_USD",
		                    each
		                        List.Sum(
		                            List.RemoveNulls(
		                                [net_worth_usd]
		                            )
		                        ),
		                    Currency.Type
		                },
		
		                // Mean wealth in USD millions
		                {
		                    "Individual_Mean_Wealth_USD_M",
		                    each
		                        let
		                            Values =
		                                List.RemoveNulls(
		                                    [net_worth_usd]
		                                )
		                        in
		                            if List.IsEmpty(Values) then
		                                null
		                            else
		                                List.Average(Values) / 1000000,
		                    type nullable number
		                },
		
		                // Median wealth in USD millions
		                {
		                    "Individual_Median_Wealth_USD_M",
		                    each
		                        let
		                            Values =
		                                List.RemoveNulls(
		                                    [net_worth_usd]
		                                )
		                        in
		                            if List.IsEmpty(Values) then
		                                null
		                            else
		                                List.Median(Values) / 1000000,
		                    type nullable number
		                },
		
		                // Maximum individual wealth
		                {
		                    "Individual_Max_Wealth_USD_M",
		                    each
		                        let
		                            Values =
		                                List.RemoveNulls(
		                                    [net_worth_usd]
		                                )
		                        in
		                            if List.IsEmpty(Values) then
		                                null
		                            else
		                                List.Max(Values) / 1000000,
		                    type nullable number
		                },
		
		                // Self-made billionaire count
		                {
		                    "Individual_Self_Made_Count",
		                    each
		                        List.Count(
		                            List.Select(
		                                [self_made],
		                                each _ = true
		                            )
		                        ),
		                    Int64.Type
		                },
		
		                // Mean age, excluding missing values
		                {
		                    "Individual_Mean_Age",
		                    each
		                        let
		                            Ages =
		                                List.RemoveNulls([age])
		                        in
		                            if List.IsEmpty(Ages) then
		                                null
		                            else
		                                List.Average(Ages),
		                    type nullable number
		                },
		
		                // Highest billionaire wealth
		                {
		                    "Individual_Top_Wealth_USD",
		                    each
		                        List.Max(
		                            List.RemoveNulls(
		                                [net_worth_usd]
		                            )
		                        ),
		                    Currency.Type
		                },
		
		                // Names of all people tied at maximum wealth
		                {
		                    "Individual_Top_Billionaire",
		                    each
		                        let
		                            GroupRows = _,
		
		                            MaximumWealth =
		                                List.Max(
		                                    List.RemoveNulls(
		                                        GroupRows[net_worth_usd]
		                                    )
		                                ),
		
		                            TopRows =
		                                Table.SelectRows(
		                                    GroupRows,
		                                    each
		                                        [net_worth_usd]
		                                        = MaximumWealth
		                                ),
		
		                            TopNames =
		                                List.Sort(
		                                    List.RemoveNulls(
		                                        TopRows[person_name]
		                                    )
		                                )
		                        in
		                            Text.Combine(TopNames, " | "),
		                    type text
		                },
		
		                // Number of people tied at maximum wealth
		                {
		                    "Individual_Top_Wealth_Tie_Count",
		                    each
		                        let
		                            GroupRows = _,
		
		                            MaximumWealth =
		                                List.Max(
		                                    List.RemoveNulls(
		                                        GroupRows[net_worth_usd]
		                                    )
		                                ),
		
		                            TopRows =
		                                Table.SelectRows(
		                                    GroupRows,
		                                    each
		                                        [net_worth_usd]
		                                        = MaximumWealth
		                                )
		                        in
		                            Table.RowCount(TopRows),
		                    Int64.Type
		                }
		            }
		        ),
		
		    // =========================================
		    // 3. SORT RESULTS
		    // =========================================
		
		    SortedCountries =
		        Table.Sort(
		            GroupedByCountry,
		            {{"iso3", Order.Ascending}}
		        )
		
		in
		    SortedCountries
	lineageTag: 6a1c777e-f4b0-467a-b480-7e45e2c573a8
	queryGroup: '05_QA & Reconciliation'

	annotation PBI_ResultType = Table

