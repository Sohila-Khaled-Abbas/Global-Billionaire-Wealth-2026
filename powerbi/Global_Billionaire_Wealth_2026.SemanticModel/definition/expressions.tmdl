		                        )
		                    ),
		                    if
		                        Table.RowCount(src_BillionaireCountry) = 80
		                        and List.Count(
		                            Table.ColumnNames(
		                                src_BillionaireCountry
		                            )
		                        ) = 23
		                    then "Passed"
		                    else "Investigate"
		                }
		            }
		        )
		in
		    Validation
