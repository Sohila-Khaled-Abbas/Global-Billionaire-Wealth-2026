		    // ================================================
		    // 2. FORBES SCRAPE TIMESTAMP VALIDATION
		    // ================================================
		
		    MissingScrapeTimestamps =
		        Table.RowCount(
		            Table.SelectRows(
		                Individual,
		                each [scrape_timestamp] = null
		            )
		        ),
		
		    NonUTCTimestamps =
		        Table.RowCount(
		            Table.SelectRows(
		                Individual,
		                each
		                    [scrape_timestamp] <> null
		                    and (
		                        DateTimeZone.ZoneHours(
		                            [scrape_timestamp]
		                        ) <> 0
		                        or
		                        DateTimeZone.ZoneMinutes(
		                            [scrape_timestamp]
		                        ) <> 0
		                    )
		            )
		        ),
		
		    ScrapeDateMismatches =
		        Table.RowCount(
		            Table.SelectRows(
		                Individual,
		                each
		                    [scrape_timestamp] = null
		                    or
		                    Date.From(
		                        DateTimeZone.RemoveZone(
		                            [scrape_timestamp]
		                        )
		                    ) <> ExpectedSnapshotDate
		            )
		        ),
		
		    // ================================================
		    // 3. GDP YEAR VALIDATION
		    // ================================================
		
		    MissingGDPYears =
		        Table.RowCount(
		            Table.SelectRows(
		                Country,
		                each [gdp_year] = null
		            )
		        ),
		
		    FutureGDPYears =
		        Table.RowCount(
		            Table.SelectRows(
		                Country,
		                each
		                    [gdp_year] <> null
		                    and [gdp_year] > Date.Year(ExpectedSnapshotDate)
		            )
		        ),
		
		    EarlierThan2023 =
		        Table.RowCount(
		            Table.SelectRows(
		                Country,
		                each
		                    [gdp_year] <> null
		                    and [gdp_year] < 2023
		            )
		        ),
		
		    // ================================================
		    // 4. VALIDATION OUTPUT
		    // ================================================
		
		    Result =
		        #table(
		            type table [
		                Check = text,
		                Actual = number,
		                Expected = number,
		                Status = text
		            ],
		            {
		                {
		                    "Individual distinct snapshot dates",
		                    List.Count(IndividualSnapshotDates),
		                    1,
		                    if
		                        List.Count(IndividualSnapshotDates) = 1
		                        and List.First(IndividualSnapshotDates) = ExpectedSnapshotDate
		                    then "Passed"
		                    else "Investigate"
		                },
		
		                {
		                    "Country distinct snapshot dates",
		                    List.Count(CountrySnapshotDates),
		                    1,
		                    if
		                        List.Count(CountrySnapshotDates) = 1
		                        and List.First(CountrySnapshotDates) = ExpectedSnapshotDate
		                    then "Passed"
		                    else "Investigate"
		                },
		
		                {
		                    "Individual snapshot-date mismatches",
		                    IndividualSnapshotDateErrors,
		                    0,
		                    if IndividualSnapshotDateErrors = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "Country snapshot-date mismatches",
		                    CountrySnapshotDateErrors,
		                    0,
		                    if CountrySnapshotDateErrors = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "Missing scrape timestamps",
		                    MissingScrapeTimestamps,
		                    0,
		                    if MissingScrapeTimestamps = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "Non-UTC scrape timestamps",
		                    NonUTCTimestamps,
		                    0,
		                    if NonUTCTimestamps = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "Scrape-date mismatches",
		                    ScrapeDateMismatches,
		                    0,
		                    if ScrapeDateMismatches = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "Missing GDP years",
		                    MissingGDPYears,
		                    0,
		                    if MissingGDPYears = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "GDP years later than snapshot year",
		                    FutureGDPYears,
		                    0,
		                    if FutureGDPYears = 0
		                    then "Passed" else "Investigate"
		                },
		
		                {
		                    "GDP years earlier than 2023 (review)",
		                    EarlierThan2023,
		                    0,
		                    if EarlierThan2023 = 0
		                    then "Passed" else "Review"
		                }
		            }
		        )
		in
		    Result
	lineageTag: e81f75ff-c1be-4274-892d-c680d3a54a5d
	queryGroup: 99_Archive

expression tmp_GDPVintageExceptionDetail =
		let
		    Source = FactCountrySnapshot,
		
		    GDPYear2022 =
		        Table.SelectRows(
		            Source,
		            each [gdp_year] = 2022
		        ),
		
		    SelectedColumns =
		        Table.SelectColumns(
		            GDPYear2022,
		            {
		                "iso3",
		                "country_wealth_rank",
		                "billionaire_count",
		                "total_wealth_usd",
		                "gdp_usd",
		                "population",
		                "gdp_year",
		                "snapshot_date"
		            }
		        ),
		
		    SortedRows =
		        Table.Sort(
		            SelectedColumns,
		            {
		                {"iso3", Order.Ascending}
		            }
		        )
		in
		    SortedRows
	lineageTag: 90eb2400-20d7-483a-8208-d4a2e881d0ce
	queryGroup: 99_Archive

