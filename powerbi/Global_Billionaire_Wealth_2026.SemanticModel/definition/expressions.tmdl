	queryGroup: 99_Archive

	annotation PBI_ResultType = Table

expression tmp_CountryReconciliationSummary =
		let
		    Source =
		        qa_CountryReconciliation,
		
		    MatchedCountries =
		        Table.SelectRows(
		            Source,
		            each [Country_Match_Status] = "Matched"
		        ),
		
		    CountMismatches =
		        Table.SelectRows(
		            Source,
		            each [Count_Reconciliation_Status] = "Count mismatch"
		        ),
		
		    WealthMismatches =
		        Table.SelectRows(
		            Source,
		            each [Wealth_Reconciliation_Status] = "Wealth mismatch"
		        ),
		
		    WealthDifferences =
		        List.RemoveNulls(
		            Source[Wealth_Difference_USD]
		        ),
		
		    MaximumWealthDifference =
		        if List.IsEmpty(WealthDifferences) then
		            null
		        else
		            List.Max(
		                List.Transform(
		                    WealthDifferences,
		                    each Number.Abs(_)
		                )
		            ),
		
		    MissingIndividual =
		        Table.SelectRows(
		            Source,
		            each [Country_Match_Status]
		                = "Missing from individual data"
		        ),
		
		    MissingAggregate =
		        Table.SelectRows(
		            Source,
		            each [Country_Match_Status]
		                = "Missing from country aggregate"
		        ),
		
		    Result =
		        #table(
		            type table [
		                Check = text,
		                Actual = number,
		                Expected = number,
		                Status = text
		            ],
		            {
		                {
		                    "Total reconciliation rows",
		                    Table.RowCount(Source),
		                    80,
		                    if Table.RowCount(Source) = 80
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Matched countries",
		                    Table.RowCount(MatchedCountries),
		                    80,
		                    if Table.RowCount(MatchedCountries) = 80
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Missing individual countries",
		                    Table.RowCount(MissingIndividual),
		                    0,
		                    if Table.RowCount(MissingIndividual) = 0
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Missing aggregate countries",
		                    Table.RowCount(MissingAggregate),
		                    0,
		                    if Table.RowCount(MissingAggregate) = 0
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Count mismatches",
		                    Table.RowCount(CountMismatches),
		                    0,
		                    if Table.RowCount(CountMismatches) = 0
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Wealth mismatches",
		                    Table.RowCount(WealthMismatches),
		                    0,
		                    if Table.RowCount(WealthMismatches) = 0
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Maximum absolute wealth difference",
		                    if MaximumWealthDifference = null
		                    then 0
		                    else MaximumWealthDifference,
		                    0,
		                    if MaximumWealthDifference = null
		                        or MaximumWealthDifference <= 0.005
		                    then "Passed" else "Investigate"
		                }
		            }
		        )
		in
		    Result
	lineageTag: e6908567-5acb-49c5-834f-e34fd2575d88
	queryGroup: '05_QA & Reconciliation'

	annotation PBI_ResultType = Table

expression tmp_CountryMetricDetailSummary =
		let
		    Source =
		        qa_CountryMetricDetail,
		
		    Summaries = {
		        [
		            Metric = "Mean wealth",
		            Column = "Mean_Wealth_Status",
		            PassedLabel = "Within source precision"
		        ],
		        [
		            Metric = "Median wealth",
		            Column = "Median_Wealth_Status",
		            PassedLabel = "Within source precision"
		        ],
		        [
		            Metric = "Maximum wealth",
		            Column = "Maximum_Wealth_Status",
		            PassedLabel = "Within source precision"
		        ],
		        [
		            Metric = "Mean age",
		            Column = "Mean_Age_Status",
		            PassedLabel = "Within source precision"
		        ],
		        [
		            Metric = "Self-made count",
		            Column = "Self_Made_Count_Status",
		            PassedLabel = "Matched"
		        ],
		        [
		            Metric = "Top billionaire",
		            Column = "Top_Billionaire_Status",
		            PassedLabel = null
		        ]
		    },
		
		    ResultRecords =
		        List.Transform(
		            Summaries,
		            (Item) =>
		                let
		                    Values =
		                        Table.Column(
		                            Source,
		                            Item[Column]
		                        ),
		
		                    Passed =
		                        if Item[Metric] = "Top billionaire" then
		                            List.Count(
		                                List.Select(
		                                    Values,
		                                    each
		                                        _ = "Matched"
		                                        or _ = "Matched - tie represented by one name"
		                                )
		                            )
		                        else
		                            List.Count(
		                                List.Select(
		                                    Values,
		                                    each _ = Item[PassedLabel]
		                                )
		                            ),
		
		                    Investigate =
		                        List.Count(
		                            List.Select(
		                                Values,
		                                each _ = "Investigate"
		                            )
		                        )
		                in
		                    [
		                        Metric = Item[Metric],
		                        Countries_Passed = Passed,
		                        Countries_Investigated = Investigate
		                    ]
		        ),
		
		    Result =
		        Table.FromRecords(ResultRecords)
		in
		    Result
	lineageTag: b69c5445-db2a-4ca4-99c4-ab88c508037f
	queryGroup: '05_QA & Reconciliation'

	annotation PBI_ResultType = Table

expression qa_CountryMetricDetail =
		let
		    Source =
		        qa_CountryReconciliation,
		
		    // =========================================
		    // 1. WEALTH DIFFERENCES
		    // Values are in USD millions
		    // =========================================
		
		    MeanDifference =
		        Table.AddColumn(
		            Source,
		            "Mean_Wealth_Difference_USD_M",
		            each Number.Abs(
		                [Individual_Mean_Wealth_USD_M]
		                - [Aggregate_Mean_Wealth_USD_M]
		            ),
		            type number
		        ),
		
		    MedianDifference =
		        Table.AddColumn(
		            MeanDifference,
		            "Median_Wealth_Difference_USD_M",
		            each Number.Abs(
		                [Individual_Median_Wealth_USD_M]
		                - [Aggregate_Median_Wealth_USD_M]
		            ),
		            type number
		        ),
		
		    MaximumDifference =
		        Table.AddColumn(
		            MedianDifference,
		            "Maximum_Wealth_Difference_USD_M",
		            each Number.Abs(
		                [Individual_Max_Wealth_USD_M]
		                - [Aggregate_Max_Wealth_USD_M]
		            ),
		            type number
		        ),
		
		    // =========================================
		    // 2. DEMOGRAPHIC AND SELF-MADE DIFFERENCES
		    // =========================================
		
		    AgeDifference =
		        Table.AddColumn(
		            MaximumDifference,
		            "Mean_Age_Difference",
		            each Number.Abs(
		                [Individual_Mean_Age]
		                - [Aggregate_Mean_Age]
		            ),
		            type number
		        ),
		
		    SelfMadeDifference =
		        Table.AddColumn(
		            AgeDifference,
		            "Self_Made_Count_Difference",
		            each
		                [Individual_Self_Made_Count]
		                - [Aggregate_Self_Made_Count],
		            Int64.Type
		        ),
		
		    // =========================================
		    // 3. SELECT A DETERMINISTIC TOP REPRESENTATIVE
		    // Preserve the original list of tied names
		    // in the base reconciliation query
		    // =========================================
		
		    TopRepresentative =
		        Table.AddColumn(
		            SelfMadeDifference,
		            "Individual_Top_Representative",
		            each
		                let
		                    Names =
		                        if [Individual_Top_Billionaire] = null
		                        then {}
		                        else
		                            Text.Split(
		                                [Individual_Top_Billionaire],
		                                " | "
		                            )
		                in
		                    if List.IsEmpty(Names)
		                    then null
		                    else List.First(Names),
		            type nullable text
		        ),
		
		    // =========================================
		    // 4. MEAN WEALTH STATUS
		    // Tolerance: 0.005 million USD
		    // =========================================
		
		    MeanStatus =
		        Table.AddColumn(
		            TopRepresentative,
		            "Mean_Wealth_Status",
		            each
		                if Number.Round(
		                    [Mean_Wealth_Difference_USD_M],
		                    6
		                ) <= 0.005
		                then "Within source precision"
		                else "Investigate",
		            type text
		        ),
		
		    MedianStatus =
		        Table.AddColumn(
		            MeanStatus,
		            "Median_Wealth_Status",
		            each
		                if Number.Round(
		                    [Median_Wealth_Difference_USD_M],
		                    6
		                ) <= 0.005
		                then "Within source precision"
		                else "Investigate",
		            type text
		        ),
		
		    MaximumStatus =
		        Table.AddColumn(
		            MedianStatus,
		            "Maximum_Wealth_Status",
		            each
		                if Number.Round(
		                    [Maximum_Wealth_Difference_USD_M],
		                    6
		                ) <= 0.005
		                then "Within source precision"
		                else "Investigate",
		            type text
		        ),
		
		    AgeStatus =
		        Table.AddColumn(
		            MaximumStatus,
		            "Mean_Age_Status",
		            each
		                if Number.Round(
		                    [Mean_Age_Difference],
		                    6
		                ) <= 0.05
		                then "Within source precision"
		                else "Investigate",
		            type text
		        ),
		
		    // =========================================
		    // 5. SELF-MADE COUNT STATUS
		    // =========================================
		
		    SelfMadeStatus =
		        Table.AddColumn(
		            AgeStatus,
		            "Self_Made_Count_Status",
		            each
		                if [Self_Made_Count_Difference] = 0
		                then "Matched"
		                else "Investigate",
		            type text
		        ),
		
		    // =========================================
		    // 6. TOP BILLIONAIRE STATUS
		    // Compare one representative, not all tied names
		    // =========================================
		
		    TopStatus =
		        Table.AddColumn(
		            SelfMadeStatus,
		            "Top_Billionaire_Status",
		            each
		                let
		                    IndividualName =
		                        [Individual_Top_Representative],
		
		                    AggregateName =
		                        [Aggregate_Top_Billionaire],
		
		                    NamesMatch =
		                        if IndividualName = null
		                            or AggregateName = null
		                        then false
		                        else
		                            Text.Upper(
		                                Text.Trim(IndividualName)
		                            )
		                            =
		                            Text.Upper(
		                                Text.Trim(AggregateName)
		                            )
		                in
		                    if not NamesMatch then
		                        "Investigate"
		                    else if [Individual_Top_Wealth_Tie_Count] > 1 then
		                        "Matched - tie represented by one name"
		                    else
		                        "Matched",
		            type text
		        )
		
		in
		    TopStatus
	lineageTag: 6195d1c5-cdf2-4b7a-8fb5-40b23d6e777f
	queryGroup: '05_QA & Reconciliation'

expression tmp_DimCountryValidation =
		let
		    Source = DimCountry,
		
		    ISO3Values =
		        List.RemoveNulls(Source[iso3]),
		
		    Result =
		        #table(
		            type table [
		                Check = text,
		                Actual = number,
		                Expected = number,
		                Status = text
		            ],
		            {
		                {
		                    "Dimension rows",
		                    Table.RowCount(Source),
		                    80,
		                    if Table.RowCount(Source) = 80
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Distinct ISO3",
		                    List.Count(List.Distinct(ISO3Values)),
		                    80,
		                    if List.Count(List.Distinct(ISO3Values)) = 80
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Missing ISO3",
		                    Table.RowCount(Source) - List.Count(ISO3Values),
		                    0,
		                    if Table.RowCount(Source) = List.Count(ISO3Values)
		                    then "Passed" else "Investigate"
		                }
		            }
		        )
		in
		    Result
	lineageTag: 591dcbbb-365c-4629-aaea-3e7e60197e46
	queryGroup: 99_Archive

expression tmp_DimIndustryValidation =
		let
		    Source = DimIndustry,
		
		    Industries =
		        List.RemoveNulls(Source[industry]),
		
		    DistinctIndustries =
		        List.Distinct(Industries),
		
		    Result =
		        #table(
		            type table [
		                Check = text,
		                Actual = number,
		                Expected = number,
		                Status = text
		            ],
		            {
		                {
		                    "Dimension rows",
		                    Table.RowCount(Source),
		                    18,
		                    if Table.RowCount(Source) = 18
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Distinct industry keys",
		                    List.Count(DistinctIndustries),
		                    18,
		                    if List.Count(DistinctIndustries) = 18
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Missing industry keys",
		                    Table.RowCount(Source) - List.Count(Industries),
		                    0,
		                    if Table.RowCount(Source) = List.Count(Industries)
		                    then "Passed" else "Investigate"
		                }
		            }
		        )
		in
		    Result
