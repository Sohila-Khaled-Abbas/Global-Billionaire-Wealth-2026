	annotation PBI_ResultType = Table

expression tmp_IndustryDistributionValidation =
		let
		    Lookup = int_IndustryLookup,
		    Distribution = tmp_IndustryDistribution,
		
		    LookupLabels =
		        List.RemoveNulls(
		            Table.Column(Lookup, "industry")
		        ),
		
		    DistributionLabels =
		        List.RemoveNulls(
		            Table.Column(
		                Distribution,
		                "primary_industry"
		            )
		        ),
		
		    LookupDistinct =
		        List.Distinct(LookupLabels),
		
		    DistributionDistinct =
		        List.Distinct(DistributionLabels),
		
		    TotalBillionaires =
		        List.Sum(
		            Table.Column(
		                Distribution,
		                "Billionaire_Count"
		            )
		        ),
		
		    LookupDuplicates =
		        List.Count(LookupLabels)
		        - List.Count(LookupDistinct),
		
		    MissingLookupLabels =
		        List.Difference(
		            DistributionDistinct,
		            LookupDistinct
		        ),
		
		    MissingDistributionLabels =
		        List.Difference(
		            LookupDistinct,
		            DistributionDistinct
		        ),
		
		    Result =
		        #table(
		            type table [
		                Check = text,
		                Actual = text,
		                Expected = text,
		                Status = text
		            ],
		            {
		                {
		                    "Industry lookup rows",
		                    Text.From(Table.RowCount(Lookup)),
		                    "18",
		                    if Table.RowCount(Lookup) = 18
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Distinct lookup labels",
		                    Text.From(List.Count(LookupDistinct)),
		                    "18",
		                    if List.Count(LookupDistinct) = 18
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Duplicate lookup labels",
		                    Text.From(LookupDuplicates),
		                    "0",
		                    if LookupDuplicates = 0
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Distribution categories",
		                    Text.From(List.Count(DistributionDistinct)),
		                    "18",
		                    if List.Count(DistributionDistinct) = 18
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Distribution total",
		                    Text.From(TotalBillionaires),
		                    "3384",
		                    if TotalBillionaires = 3384
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Labels missing from lookup",
		                    Text.From(List.Count(MissingLookupLabels)),
		                    "0",
		                    if List.IsEmpty(MissingLookupLabels)
		                    then "Passed" else "Investigate"
		                },
		                {
		                    "Labels missing from distribution",
		                    Text.From(List.Count(MissingDistributionLabels)),
		                    "0",
		                    if List.IsEmpty(MissingDistributionLabels)
		                    then "Passed" else "Investigate"
		                }
		            }
		        )
		in
		    Result
	lineageTag: c602daed-9cb1-4c0d-8edf-bd4e2c791df6
	queryGroup: 99_Archive

	annotation PBI_ResultType = Table

expression tmp_IndividualQualityAudit =
		let
		    Source = stg_BillionaireIndividual,
		
		    // Count nulls in any selected column
		    NullCount = (ColumnName as text) as number =>
		        List.Count(
		            List.Select(
		                Table.Column(Source, ColumnName),
		                each _ = null
		            )
		        ),
		
		    // Count non-positive values in numeric columns
		    NonPositiveCount = (ColumnName as text) as number =>
		        List.Count(
		            List.Select(
		                List.RemoveNulls(
		                    Table.Column(Source, ColumnName)
		                ),
		                each _ <= 0
		            )
		        ),
		
		    // Retrieve distinct values for categorical columns
		    DistinctValues = (ColumnName as text) as text =>
		        let
		            Values =
		                List.Transform(
		                    List.Distinct(
		                        List.RemoveNulls(
		                            Table.Column(Source, ColumnName)
		                        )
		                    ),
		                    each Text.From(_)
		                )
		        in
		            Text.Combine(List.Sort(Values), ", "),
		
		    AgeValues =
		        List.RemoveNulls(
		            Table.Column(Source, "age")
		        ),
		
		    AgeMinimum =
		        if List.IsEmpty(AgeValues)
		        then null else List.Min(AgeValues),
		
		    AgeMaximum =
		        if List.IsEmpty(AgeValues)
		        then null else List.Max(AgeValues),
		
		    Result =
		        #table(
		            type table [
		                Check = text,
		                Actual_Value = text,
		                Expected_or_Interpretation = text
		            ],
		            {
		                {
		                    "Age nulls",
		                    Text.From(NullCount("age")),
		                    "48 reported in dataset documentation"
		                },
		                {
		                    "Minimum age",
		                    if AgeMinimum = null then "N/A"
		                    else Text.From(AgeMinimum),
		                    "Review observed minimum"
		                },
		                {
		                    "Maximum age",
		                    if AgeMaximum = null then "N/A"
		                    else Text.From(AgeMaximum),
		                    "Review observed maximum"
		                },
		                {
		                    "Gender nulls",
		                    Text.From(NullCount("gender")),
		                    "Investigate"
		                },
		                {
		                    "Gender categories",
		                    DistinctValues("gender"),
		                    "Expected M, F"
		                },
		                {
		                    "Self-made nulls",
		                    Text.From(NullCount("self_made")),
		                    "Investigate"
		                },
		                {
		                    "Self-made categories",
		                    DistinctValues("self_made"),
		                    "Expected true, false"
		                },
		                {
		                    "Net worth nulls",
		                    Text.From(NullCount("net_worth_usd")),
		                    "Investigate"
		                },
		                {
		                    "Non-positive net worth",
		                    Text.From(NonPositiveCount("net_worth_usd")),
		                    "Investigate"
		                },
		                {
		                    "GDP nulls",
		                    Text.From(NullCount("gdp_usd")),
		                    "Investigate"
		                },
		                {
		                    "Non-positive GDP",
		                    Text.From(NonPositiveCount("gdp_usd")),
		                    "Investigate"
		                },
		                {
		                    "Population nulls",
		                    Text.From(NullCount("population")),
		                    "Investigate"
		                },
		                {
		                    "Non-positive population",
		                    Text.From(NonPositiveCount("population")),
		                    "Investigate"
		                },
		                {
		                    "Primary industry nulls",
		                    Text.From(NullCount("primary_industry")),
		                    "Expected 0 based on previous audit"
		                }
		            }
		        )
		in
		    Result
	lineageTag: f5a0b9b5-d4ba-4232-91b8-aacdb9024b40
	queryGroup: 99_Archive

expression tmp_NetWorthExceptions =
		let
		    // 1. Source
		    Source =
		        stg_BillionaireIndividual,
		
		    // 2. Keep investigation fields
		    SelectedColumns =
		        Table.SelectColumns(
		            Source,
		            {
		                "rank",
		                "person_name",
		                "country",
		                "iso3",
		                "forbes_uri",
		                "net_worth_usd",
		                "net_worth_usd_m"
		            }
		        ),
		
		    // 3. Classify absolute USD values
		    USDStatus =
		        Table.AddColumn(
		            SelectedColumns,
		            "USD_Status",
		            each
		                if [net_worth_usd] = null then
		                    "Missing"
		                else if [net_worth_usd] = 0 then
		                    "Zero"
		                else if [net_worth_usd] < 0 then
		                    "Negative"
		                else
		                    "Positive",
		            type text
		        ),
		
		    // 4. Classify USD millions
		    MillionsStatus =
		        Table.AddColumn(
		            USDStatus,
		            "USD_Millions_Status",
		            each
		                if [net_worth_usd_m] = null then
		                    "Missing"
		                else if [net_worth_usd_m] = 0 then
		                    "Zero"
		                else if [net_worth_usd_m] < 0 then
		                    "Negative"
		                else
		                    "Positive",
		            type text
		        ),
		
		    // 5. Recalculate USD from millions
		    RecalculatedUSD =
		        Table.AddColumn(
		            MillionsStatus,
		            "USD_Recalculated",
		            each
		                if [net_worth_usd_m] = null then
		                    null
		                else
		                    [net_worth_usd_m] * 1000000,
		            type nullable number
		        ),
		
		    // 6. Calculate absolute difference
		    Difference =
		        Table.AddColumn(
		            RecalculatedUSD,
		            "Absolute_Difference_USD",
		            each
		                if [net_worth_usd] = null
		                    or [USD_Recalculated] = null
		                then
		                    null
		                else
		                    Number.Abs(
		                        [net_worth_usd]
		                            - [USD_Recalculated]
		                    ),
		            type nullable number
		        ),
		
		    // 7. Retain anomalous records
		    Exceptions =
		        Table.SelectRows(
		            Difference,
		            each
		                [USD_Status] <> "Positive"
		                or [USD_Millions_Status] <> "Positive"
		        ),
		
		    // 8. Sort by Forbes rank
		    Sorted =
		        Table.Sort(
		            Exceptions,
		            {{"rank", Order.Ascending}}
		        )
		
		in
		    Sorted
	lineageTag: 161f5679-4921-440c-ba58-eb1c2b02eb6e
	queryGroup: 99_Archive

	annotation PBI_ResultType = Table

expression tmp_NetWorthConsistency =
		let
		    Source =
		        stg_BillionaireIndividual,
		
		    // Retain records with positive values in both columns
		    PositiveRecords =
		        Table.SelectRows(
		            Source,
		            each
		                [net_worth_usd] <> null
		                and [net_worth_usd_m] <> null
		                and [net_worth_usd] > 0
		                and [net_worth_usd_m] > 0
		        ),
		
		    // Recalculate USD from USD millions
		    Recalculated =
		        Table.AddColumn(
		            PositiveRecords,
		            "Recalculated_USD",
		            each
		                [net_worth_usd_m] * 1000000,
		            type number
		        ),
		
		    // Calculate difference
		    Difference =
		        Table.AddColumn(
		            Recalculated,
		            "Absolute_Difference_USD",
		            each
		                Number.Abs(
		                    [net_worth_usd] - [Recalculated_USD]
		                ),
		            type number
		        ),
		
		    // Sort largest discrepancies first
		    Sorted =
		        Table.Sort(
		            Difference,
		            {
		                {"Absolute_Difference_USD", Order.Descending}
		            }
		        ),
		
		    // Keep relevant investigation fields
		    Output =
		        Table.SelectColumns(
		            Sorted,
		            {
		                "forbes_uri",
		                "person_name",
		                "net_worth_usd",
		                "net_worth_usd_m",
		                "Recalculated_USD",
		                "Absolute_Difference_USD"
		            }
		        )
		in
		    Output
	lineageTag: c5a27da5-aa43-4fd6-9cfb-0f24be421af7
	queryGroup: 99_Archive

expression tmp_RankAudit =
		let
		    Source =
		        stg_BillionaireIndividual,
		
		    RankCounts =
		        Table.Group(
		            Source,
		            {"rank"},
		            {
		                {
		                    "Records_Per_Rank",
		                    each Table.RowCount(_),
		                    Int64.Type
		                }
		            }
		        ),
		
		    DuplicateRanks =
		        Table.SelectRows(
		            RankCounts,
		            each [Records_Per_Rank] > 1
		        ),
		
		    Sorted =
		        Table.Sort(
		            DuplicateRanks,
		            {{"rank", Order.Ascending}}
		        )
		in
		    Sorted
	lineageTag: f614d10f-a3c2-4bef-8e54-d3d1a2b2b507
