expression qa_CountryReconciliation =
		let
		  Source = Table.NestedJoin(qa_IndividualByCountry, {"iso3"}, qa_CountryAggregate, {"Aggregate_ISO3"}, "qa_CountryAggregate", JoinKind.FullOuter),
		  #"Expanded qa_CountryAggregate" = Table.ExpandTableColumn(Source, "qa_CountryAggregate", {"Aggregate_ISO3", "country", "Aggregate_Billionaire_Count", "Aggregate_Total_Wealth_USD", "Aggregate_Mean_Wealth_USD_M", "Aggregate_Median_Wealth_USD_M", "Aggregate_Max_Wealth_USD_M", "Aggregate_Self_Made_Count", "Aggregate_Self_Made_Ratio_Pct", "Aggregate_Mean_Age", "Aggregate_Top_Billionaire"}, {"Aggregate_ISO3", "country", "Aggregate_Billionaire_Count", "Aggregate_Total_Wealth_USD", "Aggregate_Mean_Wealth_USD_M", "Aggregate_Median_Wealth_USD_M", "Aggregate_Max_Wealth_USD_M", "Aggregate_Self_Made_Count", "Aggregate_Self_Made_Ratio_Pct", "Aggregate_Mean_Age", "Aggregate_Top_Billionaire"}),
		  #"Added custom" = Table.TransformColumnTypes(Table.AddColumn(#"Expanded qa_CountryAggregate", "Reconciliation_ISO3", each if [iso3] <> null then [iso3]
		else [Aggregate_ISO3]), {{"Reconciliation_ISO3", type text}}),
		  #"Added custom 1" = Table.TransformColumnTypes(Table.AddColumn(#"Added custom", "Count_Difference", each if [Individual_Billionaire_Count] = null
		    or [Aggregate_Billionaire_Count] = null
		then null
		else
		    [Individual_Billionaire_Count]
		    - [Aggregate_Billionaire_Count]), {{"Count_Difference", Int64.Type}}),
		  #"Added custom 2" = Table.TransformColumnTypes(Table.AddColumn(#"Added custom 1", "Wealth_Difference_USD", each if [Individual_Total_Wealth_USD] = null
		    or [Aggregate_Total_Wealth_USD] = null
		then null
		else
		    Number.From([Individual_Total_Wealth_USD])
		    - Number.From([Aggregate_Total_Wealth_USD])), {{"Wealth_Difference_USD", Int64.Type}}),
		  #"Added custom 3" = Table.AddColumn(#"Added custom 2", "Country_Match_Status", each if [iso3] = null then
		    "Missing from individual data"
		else if [Aggregate_ISO3] = null then
		    "Missing from country aggregate"
		else
		    "Matched", type text),
		  #"Added custom 4" = Table.TransformColumnTypes(Table.AddColumn(#"Added custom 3", "Count_Reconciliation_Status", each if [Country_Match_Status] <> "Matched" then
		    "Not comparable"
		else if [Count_Difference] = 0 then
		    "Matched"
		else
		    "Count mismatch"), {{"Count_Reconciliation_Status", type text}}),
		  #"Added custom 5" = Table.TransformColumnTypes(Table.AddColumn(#"Added custom 4", "Wealth_Reconciliation_Status", each if [Country_Match_Status] <> "Matched" then
		    "Not comparable"
		else if Number.Round(
		    Number.Abs([Wealth_Difference_USD]),
		    2
		) = 0 then
		    "Matched"
		else
		    "Wealth mismatch"), {{"Wealth_Reconciliation_Status", type text}})
		in
		  #"Added custom 5"
	lineageTag: d32e7f72-5fed-4135-aead-000444168561
	queryGroup: '05_QA & Reconciliation'

