expression int_BillionaireIndustryBridge =
		let
		    Source = stg_BillionaireIndividual,
		    #"Choose columns" = Table.SelectColumns(Source, {"forbes_uri", "industries"}),
		    #"Invoked custom function" = Table.AddColumn(
		        #"Choose columns",
		        "industry",
		        each fn_ParseIndustries([industries]),
		        type list
